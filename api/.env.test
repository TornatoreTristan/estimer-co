# Environnement de test.
#
# Base dédiée, éphémère (tmpfs) :
#   docker compose --profile test up -d db_test
#
# Le store de rate limiting est `memory` : les compteurs disparaissent entre
# deux exécutions, ce qui rend les tests de quota déterministes sans avoir à
# nettoyer une table.
TZ=UTC
NODE_ENV=test
PORT=3334
HOST=127.0.0.1
LOG_LEVEL=silent
APP_KEY=test_only_key_1234567890abcdefgh

DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=estimer
DB_PASSWORD=estimer
DB_DATABASE=estimer_test

CORS_ORIGINS=https://estimer.co,http://localhost:4322
TRUSTED_PROXY=10.0.0.0/8,127.0.0.1/32

BAN_API_URL=http://127.0.0.1:9/ban-doit-etre-bouchonne
DVF_BASE_URL=http://127.0.0.1:9/dvf-doit-etre-bouchonne
ADEME_API_URL=http://127.0.0.1:9/ademe
COG_COMMUNES_URL=http://127.0.0.1:9/cog

IP_HASH_SALT=test_salt
ESTIMATION_CACHE_TTL=86400
GEOCODE_CACHE_TTL_DAYS=90

# Aucun envoi réel pendant les tests : le message est construit et rendu,
# mais aucune connexion SMTP n'est ouverte. Les tests fonctionnels qui
# vérifient le CONTENU utilisent `mail.fake()` par-dessus.
MAIL_TRANSPORT=dry-run
MAIL_FROM_ADDRESS=contact@estimer.test
MAIL_FROM_NAME=Estimer mon bien
MAIL_TO=equipe@estimer.test
MAIL_TIMEOUT=2000
MAIL_SEND_ACKNOWLEDGEMENT=true

LIMITER_STORE=memory
RATE_LIMIT_ESTIMATION=10/1 minute
RATE_LIMIT_ESTIMATION_DAILY=60/1 day
RATE_LIMIT_GEOCODE=30/1 minute
RATE_LIMIT_MARCHE=60/1 minute
RATE_LIMIT_GLOBAL=120/1 minute

# Notification Discord : le webhook pointe vers un bouchon HTTP local, démarré
# par `tests/functional/leads_discord.spec.ts` sur ce port. Les autres tests
# qui déposent un lead reçoivent un refus de connexion immédiat — ce qui
# vérifie au passage qu'un salon injoignable ne casse pas le dépôt.
DISCORD_WEBHOOK_URL=http://127.0.0.1:9797/api/webhooks/test/jeton
DISCORD_TIMEOUT=2000
DISCORD_INCLUDE_CONTACT=true
DISCORD_USERNAME=Estimer mon bien (test)
