# Dependencies and AdonisJS build
node_modules
build
tmp

# Manifeste d'entités régénéré à chaque `node ace build|test|serve` par le
# hook `indexEntities` (AdonisJS 7). Dérivé du code source : jamais commité.
.adonisjs

# Secrets
.env
.env.local
.env.production.local
.env.development.local
# Surcharges locales de poste (ex. un port PostgreSQL déjà pris par un autre
# projet). Chargées AVANT `.env.test` par @adonisjs/env, donc prioritaires.
.env.test.local

# Frontend assets compiled code
public/assets

