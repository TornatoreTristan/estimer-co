# Ces valeurs sont exposées au navigateur (préfixe PUBLIC_) : elles remplacent
# l'ancien config.js. Restreindre la clé Google par référent HTTP dans la
# console Google Cloud, c'est la seule protection possible côté client.
PUBLIC_EMAILJS_PUBLIC_KEY=
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_GOOGLE_MAPS_API_KEY=
PUBLIC_CONTACT_EMAIL=contact@estimer.co
# ID de mesure Google Analytics 4 (format G-XXXXXXXXXX). Conservé pour les
# scripts qui le consomment via CONFIG ; la mesure d'audience elle-même passe
# désormais par le conteneur GTM ci-dessous.
PUBLIC_GA4_MEASUREMENT_ID=
#
# ---------------------------------------------------------------------------
# MESURE D'AUDIENCE ET CONSENTEMENT (cf. src/lib/analytics.ts)
# ---------------------------------------------------------------------------
# Identifiant du conteneur Google Tag Manager, format GTM-XXXXXXX.
#
# C'EST L'INTERRUPTEUR GÉNÉRAL. Vide (valeur par défaut) :
#   - aucun script Google n'est écrit dans les pages ;
#   - AUCUN BANDEAU DE CONSENTEMENT N'APPARAÎT — ce n'est pas une panne : sans
#     traceur, il n'y a pas de consentement à recueillir ;
#   - la politique de confidentialité affiche « aucun traceur n'est actif ».
# Renseigné : le socle Consent Mode v2 (tout en « denied »), le conteneur, le
# bandeau et le lien « Gestion des cookies » du pied de page s'activent
# ensemble, et la politique bascule sur le texte correspondant.
PUBLIC_GTM_CONTAINER_ID=
#
# Domaine servant le conteneur. Vide = www.googletagmanager.com. Renseigner un
# domaine de marquage côté serveur (ex. https://sst.estimer.co, comme le fait
# ritmodiag.com) fait transiter la collecte par un serveur que nous
# contrôlons : moins de blocage navigateur, et un arbitrage possible sur ce qui
# part réellement chez Google. Sans effet sur le consentement.
PUBLIC_GTM_SERVER_URL=
# URL de base de l'API d'estimation (service Coolify, cf.
# specs/estimation-donnees-reelles.md §2.3). En développement :
# http://localhost:3333. Laisser vide désactive tout appel réseau et bascule
# directement sur le repli ci-dessous.
PUBLIC_API_URL=https://api.estimer.co
# Repli quand l'API est injoignable (timeout, réseau, 5xx, 429).
#   'static' (DÉFAUT, décision client) : on calcule avec la table de repli
#            `calculerEstimation()`, un prix est TOUJOURS affiché, sous un
#            bandeau « Estimation indicative » et sans aucune mention DVF/DGFiP.
#   'none'  : mode « estimation différée » — aucun prix affiché, lead conservé.
PUBLIC_ESTIMATION_FALLBACK=static
