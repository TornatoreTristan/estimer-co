---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientConfig from '../components/ClientConfig.astro';
import RawScript from '../components/RawScript.astro';
import estimationScript from '../scripts/estimation.js?raw';
import { partenaires } from '../data/partenaires';

const benefices = [
  'Estimation 100 % gratuite et sans engagement',
  'Rapport complet sous 24 heures',
  'Analyse basée sur les transactions réelles de votre secteur',
  'Vos données ne sont jamais revendues',
];

const chiffres = [
  { value: '50 000+', label: 'Biens estimés' },
  { value: '98 %', label: 'Clients satisfaits' },
  { value: String(partenaires.length), label: 'Partenaires experts' },
  { value: '24 h', label: 'Délai de réponse' },
];

const raisons = [
  {
    titre: 'Ne sous-évaluez pas votre bien',
    texte:
      "Un prix trop bas, et vous laissez de l'argent sur la table. Une mauvaise estimation peut coûter jusqu'à 15 % de la valeur d'un bien — sur 300 000 €, cela représente 45 000 €.",
  },
  {
    titre: 'Vendez deux fois plus vite',
    texte:
      "Un bien correctement estimé se vend en moyenne deux fois plus rapidement. Les acheteurs sont informés : ils reconnaissent immédiatement un prix cohérent avec le marché.",
  },
  {
    titre: 'Négociez en position de force',
    texte:
      "Avec un rapport détaillé, vous disposez d'arguments chiffrés pour justifier votre prix. Fini les négociations à l'aveugle face à un acheteur mieux préparé que vous.",
  },
  {
    titre: "Anticipez l'impact du DPE",
    texte:
      "Le diagnostic énergétique peut faire varier un prix de 25 %. Notre estimation l'intègre au calcul, plutôt que de vous laisser le découvrir au moment de la vente.",
  },
];

const temoignages = [
  {
    quote:
      "L'estimation était précise et le rapport très complet. J'ai pu vendre mon appartement au bon prix, sans négociation interminable.",
    nom: 'Marie L.',
    detail: 'Appartement vendu à Lyon',
  },
  {
    quote:
      "J'ai reçu mon estimation en moins de 24 h et elle correspondait parfaitement au prix auquel j'ai finalement vendu ma maison.",
    nom: 'Philippe D.',
    detail: 'Maison vendue à Bordeaux',
  },
  {
    quote:
      "J'hésitais sur le prix de mon studio. L'estimation m'a permis de fixer un prix juste et de vendre en trois semaines.",
    nom: 'Sophie C.',
    detail: 'Studio vendu à Paris',
  },
];

const etapes = [
  { titre: 'Vous remplissez le formulaire', texte: 'Trois minutes suffisent pour décrire votre bien.' },
  { titre: 'Nous analysons le marché', texte: 'Nos experts étudient les données de votre secteur.' },
  { titre: 'Vous recevez le rapport', texte: 'Estimation détaillée, téléchargeable en PDF.' },
  { titre: 'Vous êtes accompagné', texte: 'Nos partenaires vous guident, si vous le souhaitez.' },
];
---

<BaseLayout
  title="Estimation gratuite de votre bien immobilier — Estimer mon bien"
  description="Estimez votre bien immobilier gratuitement et recevez un rapport détaillé sous 24 heures : fourchette de prix, marché local et impact du DPE."
>
  <Fragment slot="head">
    <ClientConfig />
    <script
      is:inline
      type="text/javascript"
      src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
  </Fragment>

  <!-- ---------------------------------------------------- Formulaire -->
  <section class="estimation">
    <div class="container">
      <div class="estimation__grid">
        <aside class="estimation__aside">
          <span class="pill">Gratuit · Sans engagement</span>
          <h1>Estimez votre bien immobilier</h1>
          <p class="lead">
            Décrivez votre bien en quelques minutes. Vous recevez un rapport détaillé, fondé sur les
            données réelles de votre marché local.
          </p>

          <ul class="check-list">
            {benefices.map((benefice) => <li>{benefice}</li>)}
          </ul>

          <div class="aside-note">
            <strong>Pas encore de DPE ?</strong>
            <p>
              Indiquez-le dans le formulaire : nous vous proposerons un devis de diagnostic gratuit
              via notre partenaire Ritmodiag.
            </p>
          </div>
        </aside>

        <div class="form-card">
          <div class="form-card__head">
            <h2>Votre bien</h2>
            <p>Tous les champs marqués d'un <span class="required">*</span> sont obligatoires.</p>
          </div>

          <form id="estimationForm">
            <div class="form-legend">Le bien</div>

            <div class="field">
              <label for="propertyType">Type de bien <span class="required">*</span></label>
              <select id="propertyType" class="select" required>
                <option value="">Sélectionnez un type</option>
                <option value="appartement">Appartement</option>
                <option value="maison">Maison</option>
                <option value="terrain">Terrain</option>
                <option value="local-commercial">Local commercial</option>
              </select>
            </div>

            <div class="field" id="hasTerrainGroup" style="display: none">
              <label for="hasTerrain">Avez-vous du terrain ? <span class="required">*</span></label>
              <select id="hasTerrain" class="select">
                <option value="">Sélectionnez une option</option>
                <option value="yes">Oui</option>
                <option value="no">Non</option>
              </select>
            </div>

            <div class="field" id="terrainSizeGroup" style="display: none">
              <label for="terrainSize">Surface du terrain (m²) <span class="required">*</span></label>
              <input type="number" id="terrainSize" class="input" placeholder="500" min="1" />
            </div>

            <div class="field">
              <label for="address">Adresse du bien <span class="required">*</span></label>
              <input type="text" id="address" class="input" placeholder="123 rue de la Paix" required />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="postalCode">Code postal <span class="required">*</span></label>
                <input
                  type="text"
                  id="postalCode"
                  class="input"
                  placeholder="75001"
                  required
                  pattern="[0-9]{5}"
                />
              </div>

              <div class="field">
                <label for="city">Ville <span class="required">*</span></label>
                <input type="text" id="city" class="input" placeholder="Paris" required />
              </div>
            </div>

            <div class="field-row">
              <div class="field">
                <label for="surface">Surface (m²) <span class="required">*</span></label>
                <input type="number" id="surface" class="input" placeholder="85" required min="1" />
              </div>

              <div class="field">
                <label for="rooms">Nombre de pièces <span class="required">*</span></label>
                <input type="number" id="rooms" class="input" placeholder="3" required min="1" />
              </div>
            </div>

            <div class="field">
              <label for="dpe">Diagnostic énergétique (DPE) <span class="required">*</span></label>
              <select id="dpe" class="select" required>
                <option value="">Sélectionnez une option</option>
                <option value="A">A — Excellent</option>
                <option value="B">B — Très bon</option>
                <option value="C">C — Bon</option>
                <option value="D">D — Moyen</option>
                <option value="E">E — Insuffisant</option>
                <option value="F">F — Mauvais</option>
                <option value="G">G — Très mauvais</option>
                <option value="unknown">Je ne connais pas mon DPE</option>
              </select>
            </div>

            <div class="field" id="dpeRequestGroup" style="display: none">
              <label for="dpeRequest">Souhaitez-vous réaliser un DPE ?</label>
              <select id="dpeRequest" class="select">
                <option value="">Sélectionnez une option</option>
                <option value="yes">Oui, je souhaite un devis</option>
                <option value="no">Non merci</option>
              </select>
            </div>

            <div id="ritmodiagLink" class="dpe-cta" style="display: none">
              <a
                href="https://www.ritmodiag.com"
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--dark btn--block"
              >
                Obtenir un devis DPE gratuit &rarr;
              </a>
            </div>

            <div class="form-legend">Votre situation</div>

            <div class="field-row">
              <div class="field">
                <label for="isOwner">Êtes-vous propriétaire ? <span class="required">*</span></label>
                <select id="isOwner" class="select" required>
                  <option value="">Sélectionnez une option</option>
                  <option value="yes">Oui</option>
                  <option value="no">Non</option>
                </select>
              </div>

              <div class="field">
                <label for="wantToSell">Souhaitez-vous vendre ? <span class="required">*</span></label>
                <select id="wantToSell" class="select" required>
                  <option value="">Sélectionnez une option</option>
                  <option value="yes">Oui</option>
                  <option value="no">Non, juste une estimation</option>
                  <option value="maybe">Peut-être, je réfléchis</option>
                </select>
              </div>
            </div>

            <div class="form-legend">Vos coordonnées</div>

            <div class="field">
              <label for="name">Nom et prénom <span class="required">*</span></label>
              <input type="text" id="name" class="input" placeholder="Jean Dupont" required />
            </div>

            <div class="field-row">
              <div class="field">
                <label for="email">Email <span class="required">*</span></label>
                <input
                  type="email"
                  id="email"
                  class="input"
                  placeholder="jean.dupont@email.com"
                  required
                />
              </div>

              <div class="field">
                <label for="phone">Téléphone <span class="required">*</span></label>
                <input type="tel" id="phone" class="input" placeholder="06 12 34 56 78" required />
              </div>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--block">
              <span>Recevoir mon estimation gratuite</span>
              <span>&rarr;</span>
            </button>
          </form>

          <p class="form-card__foot">
            Connexion sécurisée. Vos informations sont protégées et ne sont jamais revendues.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ----------------------------------------------------- Chiffres -->
  <section class="section--sm section--dark">
    <div class="container">
      <div class="stat-band stat-band--dark">
        {
          chiffres.map((chiffre) => (
            <div class="stat">
              <div class="stat__value">{chiffre.value}</div>
              <div class="stat__label">{chiffre.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------- Étapes -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Comment ça marche</span>
        <h2>De votre formulaire à votre rapport</h2>
      </div>

      <div class="grid grid--4">
        {
          etapes.map((etape, i) => (
            <article class="step-card">
              <span class="step-card__num mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{etape.titre}</h3>
              <p>{etape.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------ Pourquoi -->
  <section class="section section--beige">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pourquoi estimer</span>
        <h2>Une estimation juste change l'issue de votre vente</h2>
        <p>
          L'écart entre un prix bien calibré et un prix approximatif se compte en dizaines de
          milliers d'euros et en mois de délai.
        </p>
      </div>

      <div class="grid grid--2">
        {
          raisons.map((raison) => (
            <article class="card card--hover">
              <h3>{raison.titre}</h3>
              <p>{raison.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- --------------------------------------------------- Témoignages -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Témoignages</span>
        <h2>Ce que disent les propriétaires</h2>
      </div>

      <div class="grid grid--3">
        {
          temoignages.map((temoignage) => (
            <figure class="card quote">
              <div class="quote__stars" aria-label="5 étoiles sur 5">
                ★★★★★
              </div>
              <blockquote>{temoignage.quote}</blockquote>
              <figcaption>
                <strong>{temoignage.nom}</strong>
                <span>{temoignage.detail}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <RawScript slot="body-end" code={estimationScript} />
</BaseLayout>

<style>
  .estimation {
    padding: clamp(2.5rem, 1.5rem + 4vw, 5rem) 0 clamp(3rem, 2rem + 4vw, 5.5rem);
    background:
      radial-gradient(55rem 30rem at 15% -10%, var(--orange-10) 0%, transparent 60%),
      linear-gradient(180deg, var(--beige-25) 0%, var(--beige-10) 100%);
    border-bottom: 1px solid var(--border);
  }

  .estimation__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }

  .estimation__aside {
    position: sticky;
    top: 6rem;
  }

  .estimation__aside .pill {
    margin-bottom: 1.25rem;
  }

  .estimation__aside h1 {
    margin-bottom: 1rem;
  }

  .estimation__aside .lead {
    margin-bottom: 2rem;
  }

  .aside-note {
    margin-top: 2rem;
    padding: 1.25rem;
    border: 1px solid var(--orange-25);
    background: var(--orange-5);
  }

  .aside-note strong {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .aside-note p {
    font-size: var(--text-sm);
    color: var(--text-soft);
    line-height: 1.55;
  }

  /* ------------------------------------------------------ Carte formulaire */
  .form-card {
    background: var(--white);
    border: 1px solid var(--border);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .form-card__head {
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .form-card__head h2 {
    font-size: var(--h3);
    margin-bottom: 0.375rem;
  }

  .form-card__head p {
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .required {
    color: var(--orange);
  }

  .dpe-cta {
    margin: 1.25rem 0;
  }

  .form-card button[type='submit'] {
    margin-top: 1.75rem;
  }

  .form-card__foot {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-tiny);
    color: var(--text-faint);
    text-align: center;
  }

  /* --------------------------------------------------------------- Étapes */
  .step-card {
    padding: 1.5rem 0 0;
    border-top: 2px solid var(--border);
  }

  .step-card__num {
    display: block;
    font-size: var(--text-tiny);
    letter-spacing: 0.14em;
    color: var(--orange);
    margin-bottom: 0.875rem;
  }

  .step-card h3 {
    font-size: var(--text-md);
    margin-bottom: 0.5rem;
  }

  .step-card p {
    font-size: var(--text-sm);
    color: var(--text-soft);
    line-height: 1.55;
  }

  /* ---------------------------------------------------------- Témoignages */
  .quote {
    display: flex;
    flex-direction: column;
  }

  .quote__stars {
    color: var(--orange);
    letter-spacing: 0.15em;
    font-size: var(--text-sm);
    margin-bottom: 1rem;
  }

  .quote blockquote {
    flex: 1;
    font-size: var(--text-md);
    line-height: 1.55;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .quote figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .quote figcaption span {
    color: var(--text-faint);
  }

  @media (max-width: 992px) {
    .estimation__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .estimation__aside {
      position: static;
    }
  }
</style>
