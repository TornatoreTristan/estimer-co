---
import BaseLayout from '../layouts/BaseLayout.astro';
import { partenaires } from '../data/partenaires';

const logos = partenaires.slice(0, 8).map((p) => p.logo);

const problemes = [
  {
    titre: 'Des estimations qui varient du simple au double',
    texte:
      "Trois agences, trois prix. Sans méthode ni données, impossible de savoir laquelle a raison — et l'écart peut atteindre 15 à 20 % de la valeur de votre bien.",
  },
  {
    titre: 'Un bien affiché trop cher qui ne part pas',
    texte:
      "Un prix mal calibré, et votre annonce s'installe dans le paysage. Après trois mois sans visite, la seule issue est la baisse de prix — celle que vous vouliez éviter.",
  },
  {
    titre: 'Aucune visibilité sur votre marché local',
    texte:
      "Les prix ne bougent pas de la même façon d'une rue à l'autre. Sans les transactions réelles de votre secteur, vous négociez à l'aveugle.",
  },
];

const blocs = [
  {
    eyebrow: 'Analyse de marché',
    titre: 'Les transactions réelles de votre secteur, pas une moyenne nationale',
    texte:
      "Nous croisons les ventes récentes de votre quartier, la tension du marché local et l'évolution des prix sur 12 mois pour situer votre bien au bon endroit de la fourchette.",
    lien: { href: '/carte', label: 'Voir les prix par région' },
    visuel: 'marche',
  },
  {
    eyebrow: 'Évaluation technique',
    titre: 'Chaque critère qui fait varier le prix, pris en compte',
    texte:
      "Surface, nombre de pièces, état, exposition, terrain, équipements et DPE. Le diagnostic énergétique pèse à lui seul jusqu'à 25 % du prix : nous l'intégrons au calcul plutôt que de l'ignorer.",
    lien: { href: '/estimation', label: 'Estimer mon bien' },
    visuel: 'criteres',
  },
  {
    eyebrow: 'Réseau de partenaires',
    titre: 'Et si vous vendez, les bons professionnels au bon moment',
    texte:
      `${partenaires.length} partenaires — réseaux d'agences, banques, notaires et diagnostiqueurs — que nous vous présentons uniquement si vous le demandez. Jamais de revente de vos coordonnées.`,
    lien: { href: '/partenaires', label: 'Découvrir nos partenaires' },
    visuel: 'partenaires',
  },
];

const chiffres = [
  { value: '50 000+', label: 'Estimations réalisées' },
  { value: String(partenaires.length), label: 'Partenaires de confiance' },
  { value: '98 %', label: 'Clients satisfaits' },
  { value: '24 h', label: 'Délai de réponse moyen' },
];

const temoignages = [
  {
    quote:
      "L'estimation était précise et le rapport très complet. J'ai pu fixer mon prix sans hésiter et vendre mon appartement en six semaines.",
    nom: 'Marie L.',
    detail: 'Appartement vendu à Lyon',
  },
  {
    quote:
      "J'ai reçu mon estimation en moins de 24 h et elle correspondait exactement au prix auquel j'ai finalement vendu ma maison.",
    nom: 'Philippe D.',
    detail: 'Maison vendue à Bordeaux',
  },
  {
    quote:
      "J'hésitais sur le prix de mon studio. Le rapport m'a donné les arguments pour tenir ma position face aux acheteurs.",
    nom: 'Sophie C.',
    detail: 'Studio vendu à Paris',
  },
];

const profils = [
  {
    titre: 'Vous vendez',
    sousTitre: 'Fixez le juste prix, dès le premier jour',
    texte:
      "Un prix cohérent avec le marché attire les visites tout de suite. Vous partez avec un rapport chiffré qui justifie votre position face aux acheteurs comme face aux agences.",
  },
  {
    titre: 'Vous réfléchissez',
    sousTitre: 'Sachez ce que vaut votre bien, sans engagement',
    texte:
      "Rien ne vous oblige à vendre. Beaucoup de propriétaires demandent une estimation simplement pour savoir où ils en sont avant d'arbitrer un projet.",
  },
  {
    titre: 'Vous gérez un patrimoine',
    sousTitre: 'Pilotez la valeur de vos biens dans le temps',
    texte:
      "Suivez l'évolution de vos actifs immobiliers, anticipez l'impact des nouvelles normes énergétiques et arbitrez vos investissements sur des chiffres, pas des impressions.",
  },
];

const garanties = [
  {
    titre: 'Gratuit et sans engagement',
    texte:
      "Aucun frais, aucune carte bancaire, aucune obligation de vendre. L'estimation de qualité doit rester accessible à tous les propriétaires.",
  },
  {
    titre: 'Vos données restent chez vous',
    texte:
      'Vos informations ne sont ni revendues ni transmises à un partenaire sans votre accord explicite. Hébergement en France.',
  },
  {
    titre: 'Une méthode documentée',
    texte:
      'Chaque estimation est justifiée par des données concrètes. Vous voyez comment nous arrivons au chiffre, pas seulement le chiffre.',
  },
];

const etapes = [
  {
    titre: 'Vous décrivez votre bien',
    duree: '3 minutes',
    points: [
      'Type de bien, surface et nombre de pièces',
      'Adresse exacte et code postal',
      'Diagnostic énergétique (ou demande de DPE)',
    ],
  },
  {
    titre: 'Nous analysons le marché',
    duree: 'Sous 24 heures',
    points: [
      'Transactions réelles de votre secteur',
      'Pondération selon les critères de votre bien',
      'Fourchette basse, moyenne et haute',
    ],
  },
  {
    titre: 'Vous recevez votre rapport',
    duree: 'Immédiatement disponible',
    points: [
      'Estimation détaillée et téléchargeable en PDF',
      'Analyse du marché local et de sa dynamique',
      'Mise en relation avec un expert, si vous le souhaitez',
    ],
  },
];
---

<BaseLayout
  title="Estimer mon bien — l'estimation immobilière fiable, gratuite et rapide"
  description="Recevez sous 24 h un rapport complet sur la valeur de votre bien immobilier : analyse du marché local, impact du DPE et fourchette de prix justifiée."
>
  <!-- ------------------------------------------------------------ Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__copy">
          <span class="pill">Gratuit · Sans engagement</span>
          <h1>L'estimation immobilière fiable, gratuite et rapide</h1>
          <p class="lead">
            Recevez un rapport complet sur la valeur de votre bien : transactions réelles de votre
            secteur, impact du DPE et fourchette de prix justifiée. Sous 24 heures.
          </p>
          <div class="btn-row">
            <a href="/estimation" class="btn btn--primary btn--lg">Estimer mon bien</a>
            <a href="/carte" class="btn btn--outline btn--lg">Voir les prix au m²</a>
          </div>
          <p class="hero__note">
            <strong>50 000+</strong> propriétaires accompagnés &nbsp;·&nbsp; <strong>98 %</strong> de
            clients satisfaits
          </p>
        </div>

        <!-- Aperçu du rapport, dessiné en CSS plutôt qu'en image -->
        <div class="hero__preview" aria-hidden="true">
          <div class="preview">
            <div class="preview__head">
              <span class="preview__dot"></span>
              <span class="mono">Rapport d'estimation</span>
            </div>
            <div class="preview__body">
              <div class="preview__label">Estimation moyenne</div>
              <div class="preview__price">348 500 €</div>
              <div class="preview__range">
                <div><span>Minimum</span><strong>331 100 €</strong></div>
                <div><span>Maximum</span><strong>365 900 €</strong></div>
              </div>
              <div class="preview__bar"><span></span></div>
              <ul class="preview__rows">
                <li><span>Prix au m²</span><strong>4 100 €</strong></li>
                <li><span>Surface</span><strong>85 m²</strong></li>
                <li><span>DPE</span><strong class="tag tag--ok">C</strong></li>
                <li><span>Marché local 12 mois</span><strong class="up">+2,4 %</strong></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- --------------------------------------------------- Bandeau logos -->
  <section class="section--sm logos">
    <div class="container">
      <p class="logos__title">Un réseau de {partenaires.length} partenaires de confiance</p>
      <div class="logos__row">
        {logos.map((logo) => <span>{logo}</span>)}
      </div>
    </div>
  </section>

  <!-- --------------------------------------------------------- Problème -->
  <section class="section section--beige">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Le problème</span>
        <h2>Personne ne sait vraiment ce que vaut son bien.</h2>
        <p>
          Un prix affiché au doigt mouillé, trois avis d'agence contradictoires, et une décision à
          plusieurs centaines de milliers d'euros prise sans donnée fiable.
        </p>
      </div>

      <div class="grid grid--3">
        {
          problemes.map((probleme) => (
            <article class="card card--hover problem">
              <h3>{probleme.titre}</h3>
              <p>{probleme.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------- Blocs alternés -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">La solution</span>
        <h2>Une estimation construite sur des données, pas sur une intuition</h2>
        <p>
          Trois briques d'analyse, un seul rapport. Vous savez exactement d'où vient le chiffre.
        </p>
      </div>

      <div class="blocks">
        {
          blocs.map((bloc) => (
            <article class="block">
              <div class="block__copy">
                <span class="eyebrow">{bloc.eyebrow}</span>
                <h3>{bloc.titre}</h3>
                <p>{bloc.texte}</p>
                <a href={bloc.lien.href} class="link-arrow">
                  {bloc.lien.label}
                </a>
              </div>

              <div class="block__visual" aria-hidden="true">
                {bloc.visuel === 'marche' && (
                  <div class="viz viz--chart">
                    <div class="viz__head">
                      <span class="mono">Prix au m² · 12 mois</span>
                      <span class="up">+2,4 %</span>
                    </div>
                    <div class="bars">
                      {[42, 55, 48, 63, 58, 71, 66, 80, 76, 88, 84, 96].map((h) => (
                        <span style={`height:${h}%`} />
                      ))}
                    </div>
                  </div>
                )}

                {bloc.visuel === 'criteres' && (
                  <div class="viz viz--dpe">
                    <div class="viz__head">
                      <span class="mono">Impact du DPE sur le prix</span>
                    </div>
                    <ul class="dpe">
                      <li>
                        <span class="dpe__letter dpe__letter--a">A</span>
                        <span class="dpe__track">
                          <span style="width:100%" />
                        </span>
                        <strong>+15 %</strong>
                      </li>
                      <li>
                        <span class="dpe__letter dpe__letter--c">C</span>
                        <span class="dpe__track">
                          <span style="width:62%" />
                        </span>
                        <strong>référence</strong>
                      </li>
                      <li>
                        <span class="dpe__letter dpe__letter--f">F</span>
                        <span class="dpe__track">
                          <span style="width:34%" />
                        </span>
                        <strong>−18 %</strong>
                      </li>
                      <li>
                        <span class="dpe__letter dpe__letter--g">G</span>
                        <span class="dpe__track">
                          <span style="width:22%" />
                        </span>
                        <strong>−25 %</strong>
                      </li>
                    </ul>
                  </div>
                )}

                {bloc.visuel === 'partenaires' && (
                  <div class="viz viz--net">
                    {partenaires.slice(0, 9).map((partenaire) => (
                      <span class="chip">{partenaire.logo}</span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ----------------------------------------------------------- Chiffres -->
  <section class="section--sm section--dark">
    <div class="container">
      <div class="stat-band stat-band--dark">
        {
          chiffres.map((chiffre) => (
            <div class="stat">
              <div class="stat__value">{chiffre.value}</div>
              <div class="stat__label">{chiffre.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------- Témoignages -->
  <section class="section section--beige">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Témoignages</span>
        <h2>Ils ont vendu au prix qu'ils avaient fixé.</h2>
      </div>

      <div class="grid grid--3">
        {
          temoignages.map((temoignage) => (
            <figure class="card quote">
              <div class="quote__stars" aria-label="5 étoiles sur 5">
                ★★★★★
              </div>
              <blockquote>{temoignage.quote}</blockquote>
              <figcaption>
                <strong>{temoignage.nom}</strong>
                <span>{temoignage.detail}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------ Pour qui -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pour qui ?</span>
        <h2>Conçu pour les propriétaires qui veulent un chiffre, pas un discours</h2>
      </div>

      <div class="grid grid--3">
        {
          profils.map((profil) => (
            <article class="card card--hover persona">
              <span class="pill pill--neutral">{profil.titre}</span>
              <h3>{profil.sousTitre}</h3>
              <p>{profil.texte}</p>
            </article>
          ))
        }
      </div>

      <div class="grid grid--3 guarantees">
        {
          garanties.map((garantie) => (
            <article class="guarantee">
              <h4>{garantie.titre}</h4>
              <p>{garantie.texte}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------- Étapes -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Comment ça marche</span>
        <h2>Trois étapes, aucune visite obligatoire</h2>
        <p>Le formulaire prend trois minutes. Le rapport arrive sous 24 heures.</p>
      </div>

      <div class="steps">
        {
          etapes.map((etape, i) => (
            <article class="step">
              <div class="step__num mono">{String(i + 1).padStart(2, '0')}</div>
              <h3>{etape.titre}</h3>
              <span class="step__duree mono">{etape.duree}</span>
              <ul class="check-list">
                {etape.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------- CTA final -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head section-head--center">
        <h2>Prêt à découvrir la valeur de votre bien ?</h2>
        <p>Deux façons de commencer, selon le temps que vous avez devant vous.</p>
      </div>

      <div class="grid grid--2 final-cta">
        <article class="card card--dark">
          <span class="pill">En autonomie</span>
          <h3>Estimation en ligne</h3>
          <p>
            Trois minutes de formulaire, un rapport détaillé sous 24 heures. Gratuit, sans
            engagement, sans carte bancaire.
          </p>
          <a href="/estimation" class="btn btn--light">Estimer mon bien</a>
        </article>

        <article class="card card--dark">
          <span class="pill pill--neutral">Accompagné</span>
          <h3>Parler à un expert</h3>
          <p>
            Une question sur votre situation, un bien atypique, un projet particulier ? Notre équipe
            vous répond sous 24 heures.
          </p>
          <a href="/contact" class="btn btn--ghost-light">Nous contacter</a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------- Hero */
  .hero {
    position: relative;
    padding: clamp(3rem, 1.5rem + 5vw, 6rem) 0 clamp(3.5rem, 2rem + 5vw, 6.5rem);
    background:
      radial-gradient(60rem 32rem at 78% -12%, var(--orange-10) 0%, transparent 62%),
      linear-gradient(180deg, var(--beige-25) 0%, var(--beige-10) 100%);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }

  .hero__copy .pill {
    margin-bottom: 1.5rem;
  }

  .hero__copy h1 {
    margin-bottom: 1.25rem;
  }

  .hero__copy .lead {
    max-width: 34rem;
    margin-bottom: 2rem;
  }

  .hero__note {
    margin-top: 1.5rem;
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .hero__note strong {
    color: var(--black);
    font-weight: 600;
  }

  /* Aperçu du rapport */
  .preview {
    background: var(--white);
    border: 1px solid var(--border-strong);
  }

  .preview__head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--beige-10);
    font-size: var(--text-tiny);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .preview__dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--orange);
  }

  .preview__body {
    padding: clamp(1.5rem, 1rem + 1.5vw, 2rem);
  }

  .preview__label {
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .preview__price {
    font-size: clamp(2.25rem, 1.5rem + 2.4vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0.25rem 0 1.25rem;
  }

  .preview__range {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .preview__range div {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--border);
    background: var(--beige-10);
  }

  .preview__range span {
    font-size: var(--text-tiny);
    color: var(--text-faint);
  }

  .preview__range strong {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .preview__bar {
    height: 0.375rem;
    margin: 1.25rem 0;
    background: var(--beige-50);
    overflow: hidden;
  }

  .preview__bar span {
    display: block;
    width: 68%;
    height: 100%;
    background: linear-gradient(90deg, var(--orange-50), var(--orange));
  }

  .preview__rows {
    display: grid;
    gap: 0.125rem;
  }

  .preview__rows li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0;
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .preview__rows strong {
    font-weight: 600;
    color: var(--black);
  }

  .tag {
    padding: 0.125rem 0.5rem;
    font-size: var(--text-tiny);
  }

  .tag--ok {
    background: var(--success-soft);
    color: var(--success);
  }

  .up {
    color: var(--success);
    font-weight: 600;
  }

  /* ------------------------------------------------------------ Logos */
  .logos {
    background: var(--white);
    border-bottom: 1px solid var(--border);
  }

  .logos__title {
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 1.75rem;
  }

  .logos__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 2.5rem;
  }

  .logos__row span {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--aubergine-4);
    transition: color 0.2s var(--ease);
  }

  .logos__row span:hover {
    color: var(--aubergine-1);
  }

  /* --------------------------------------------------------- Problème */
  .problem {
    border-top: 3px solid var(--orange-25);
  }

  .problem h3 {
    font-size: var(--h4);
    margin-bottom: 0.75rem;
  }

  /* --------------------------------------------------- Blocs alternés */
  .blocks {
    display: grid;
    gap: clamp(3rem, 1.5rem + 4vw, 5rem);
  }

  .block {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    align-items: center;
  }

  .block:nth-child(even) .block__copy {
    order: 2;
  }

  .block__copy h3 {
    font-size: var(--h3);
    margin-bottom: 1rem;
    max-width: 24ch;
  }

  .block__copy p {
    color: var(--text-soft);
    font-size: var(--text-md);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .viz {
    background: var(--beige-25);
    border: 1px solid var(--border);
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .viz__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-tiny);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 1.25rem;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    height: 11rem;
  }

  .bars span {
    flex: 1;
    background: var(--orange-25);
  }

  .bars span:nth-last-child(-n + 3) {
    background: var(--orange);
  }

  .dpe {
    display: grid;
    gap: 0.875rem;
  }

  .dpe li {
    display: grid;
    grid-template-columns: 1.75rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-sm);
  }

  .dpe__letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--white);
  }

  .dpe__letter--a {
    background: #446f28;
  }
  .dpe__letter--c {
    background: #9cce7b;
    color: var(--black);
  }
  .dpe__letter--f {
    background: var(--orange-95);
  }
  .dpe__letter--g {
    background: var(--error);
  }

  .dpe__track {
    height: 0.5rem;
    background: var(--beige-75);
    overflow: hidden;
  }

  .dpe__track span {
