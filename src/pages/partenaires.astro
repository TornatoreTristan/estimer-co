---
import BaseLayout from '../layouts/BaseLayout.astro';
import { partenaires } from '../data/partenaires';
---

<BaseLayout
  title="Nos partenaires. Estimer mon bien"
  description="Nos partenaires de confiance : agences immobilières et expert du diagnostic, sélectionnés un par un pour vous accompagner après votre estimation."
>
  <!-- --------------------------------------------------------- En-tête -->
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Notre réseau</span>
      <h1>{partenaires.length} partenaires de confiance</h1>
      <p class="lead">
        Des agences immobilières et un expert du diagnostic, sélectionnés un par un. Nous ne vous
        mettons en relation avec eux que si vous le demandez. Vos coordonnées ne leur sont
        transmises qu'avec votre accord.
      </p>
    </div>
  </section>

  <!-- ------------------------------------------------------ Partenaires -->
  <section class="section section--white">
    <div class="container">
      <div class="grid grid--3">
        {
          partenaires.map((partenaire) => (
            <article
              class:list={['partner', 'card', 'card--hover', { 'partner--featured': partenaire.featured }]}
            >
              <div class="partner__logo">
                {
                  partenaire.logo ? (
                    <img
                      src={partenaire.logo}
                      alt={`Logo ${partenaire.name}`}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    partenaire.logoTexte
                  )
                }
              </div>
              {partenaire.featured && <span class="partner__badge">Partenaire privilégié</span>}
              <h3>{partenaire.name}</h3>
              <p>{partenaire.description}</p>
              <a
                href={partenaire.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link-arrow"
              >
                Visiter le site
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------------- CTA final -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head section-head--center">
        <span class="eyebrow">Professionnels</span>
        <h2>Devenir partenaire</h2>
        <p>
          Vous êtes agence, banque, notaire ou diagnostiqueur ? Rejoignez notre réseau et recevez des
          propriétaires qualifiés, sur votre secteur, au moment où ils préparent leur projet.
        </p>
      </div>
      <div class="btn-row btn-row--center">
        <a href="/contact/" class="btn btn--light btn--lg">Nous contacter</a>
        <a href="/estimation/" class="btn btn--ghost-light btn--lg">Voir le parcours client</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: clamp(3rem, 2rem + 4vw, 5rem) 0;
    background:
      radial-gradient(55rem 30rem at 80% -20%, var(--orange-10) 0%, transparent 60%),
      linear-gradient(180deg, var(--beige-25) 0%, var(--beige-10) 100%);
    border-bottom: 1px solid var(--border);
  }

  .page-head h1 {
    margin-bottom: 1rem;
    max-width: 20ch;
  }

  .page-head .lead {
    max-width: 40rem;
  }

  .partner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .partner__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 5.5rem;
    margin-bottom: 1.25rem;
    padding: 0.75rem;
    border: 1px solid var(--border);
    background: var(--beige-25);
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--aubergine-1);
    text-align: center;
  }

  /* `contain` : les logos fournis ont des ratios très variables (RITMODiag est
     en 3,6:1, Les Bons Biens en 6,6:1) — on les inscrit dans la pastille sans
     jamais les rogner ni les déformer. Le plafond de hauteur, plus bas que la
     pastille, est ce qui donne aux logotypes une taille optique comparable :
     borner par la largeur seule ferait paraître les marques les plus larges
     deux fois plus grosses que les autres. */
  .partner__logo img {
    max-width: 100%;
    max-height: 3rem;
    object-fit: contain;
  }

  .partner h3 {
    font-size: var(--text-md);
    margin-bottom: 0.5rem;
  }

  .partner p {
    flex: 1;
    margin-bottom: 1.25rem;
  }

  /* Carte mise en avant : même grammaire plate que le reste, accent orange. */
  .partner--featured {
    background: var(--orange-5);
    border-color: var(--orange);
    box-shadow: inset 0 0 0 1px var(--orange);
  }

  .partner--featured:hover {
    background: var(--orange-10);
    border-color: var(--orange);
  }

  .partner--featured .partner__logo {
    background: var(--orange-10);
    border-color: var(--orange-50);
    color: var(--orange);
  }

  .partner__badge {
    display: inline-block;
    margin-bottom: 0.625rem;
    padding: 0.25rem 0.625rem;
    background: var(--orange);
    color: var(--white);
    font-size: var(--text-tiny);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
