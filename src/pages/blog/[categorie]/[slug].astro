---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ArticleHeader from '../../../components/blog/ArticleHeader.astro';
import RelatedArticles from '../../../components/blog/RelatedArticles.astro';
import CtaEstimation from '../../../components/blog/CtaEstimation.astro';
import FaqAccordion from '../../../components/blog/FaqAccordion.astro';
import AuteurEncart from '../../../components/blog/AuteurEncart.astro';
import JsonLd from '../../../components/seo/JsonLd.astro';
import { BLOG_INDEX_URL, getArticleUrl, getCategory, getCategoryUrl, isPublished } from '../../../lib/blog';
import { getAuteur, getProfilsSociaux } from '../../../lib/auteurs';
import '../../../styles/blog-charts.css';

// Uniquement les articles publiés (specs/blog-seo.md §3 "Article" : "Given un
// article brouillon, [...] aucune page n'est générée"). La route utilise la
// catégorie DE L'ARTICLE (pas une combinatoire catégorie × slug) : un article
// n'a donc jamais deux URLs.
export async function getStaticPaths() {
  const entries = await getCollection('articles', ({ data }) => isPublished(data));
  return entries.map((entry) => ({
    params: { categorie: entry.data.categorie, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
// `getCategory` ne peut pas renvoyer `undefined` ici : `data.categorie` est
// validée par l'enum Zod de `src/content.config.ts`, synchronisée avec
// `CategorieSlug` (src/lib/blog.ts).
const category = getCategory(data.categorie)!;
const { Content } = await render(entry);

const auteur = getAuteur(data.auteur);

const pageTitle = data.metaTitle ?? data.title;
const pageDescription = data.metaDescription ?? data.extrait;

// Toujours définies pour un article publié (Gate de publication,
// scripts/validate-content.mjs) : le `!` reflète cette garantie, pas une
// supposition optimiste.
const datePublication = data.datePublication!;
const dateMiseAJour = data.dateMiseAJour!;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: pageDescription,
  image: new URL(data.image ?? '/icon-512.png', Astro.site).toString(),
  datePublished: datePublication.toISOString(),
  dateModified: dateMiseAJour.toISOString(),
  author: {
    '@type': 'Person',
    name: auteur.nom,
    jobTitle: auteur.fonction,
    description: auteur.bio,
    ...(auteur.photo && { image: new URL(auteur.photo, Astro.site).toString() }),
    url: new URL(`${Astro.url.pathname}#auteur`, Astro.site).toString(),
    sameAs: getProfilsSociaux(auteur),
    worksFor: {
      '@type': 'Organization',
      name: 'Estimer.co',
      url: Astro.site?.toString(),
    },
  },
  publisher: {
    '@type': 'Organization',
    name: 'RITMODiag',
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logos/ritmodiag.svg', Astro.site).toString(),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  type="article"
  image={data.image}
  publishedTime={datePublication}
  modifiedTime={dateMiseAJour}
>
  <Fragment slot="head">
    <JsonLd data={articleJsonLd} />
  </Fragment>

  <div class="container">
    <Breadcrumb
      items={[
        { label: 'Accueil', href: '/' },
        { label: 'Blog', href: BLOG_INDEX_URL },
        { label: category.label, href: getCategoryUrl(category.slug) },
        { label: data.title, href: getArticleUrl(data.categorie, data.slug) },
      ]}
    />
  </div>

  <ArticleHeader
    title={data.title}
    extrait={data.extrait}
    image={data.image}
    imageAlt={data.imageAlt}
    imageCadrage={data.imageCadrage}
    auteur={auteur.nom}
    auteurPhoto={auteur.photo}
    categorie={data.categorie}
    categoryLabel={category.label}
    datePublication={datePublication}
    dateMiseAJour={dateMiseAJour}
  />

  <article class="article-body">
    <div class="container">
      <div class="article-body__inner">
        <Content />
        <AuteurEncart auteur={auteur} />
      </div>
    </div>
  </article>

  <div class="container">
    <div class="article-body__inner">
      <CtaEstimation />
    </div>
  </div>

  <FaqAccordion faq={data.faq} />

  <RelatedArticles currentSlug={data.slug} categorie={data.categorie} articlesLies={data.articlesLies} />
</BaseLayout>

<style>
  /* Largeur de lecture ~70ch (specs/blog-seo.md §6), volontairement distincte
     de `.container--narrow` (56rem, calibrée pour les pages légales à deux
     colonnes) : le corps d'article n'a qu'une colonne, 70ch est la largeur de
     lecture recommandée quel que soit le rendu final de la police. */
  .article-body__inner {
    max-width: 70ch;
    margin: 0 auto;
  }

  .article-body {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem) 0 clamp(2rem, 1rem + 3vw, 3rem);
  }

  .article-body :global(h2) {
    font-size: var(--h3);
    margin: 2.5rem 0 1rem;
  }

  .article-body :global(h2:first-child) {
    margin-top: 0;
  }

  .article-body :global(h3) {
    font-size: var(--text-lg);
    margin: 2rem 0 0.75rem;
  }

  .article-body :global(p) {
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--text-soft);
    margin-bottom: 1.25rem;
  }

  /* global.css retire les puces de toutes les listes (`list-style: none`) :
     le corps d'article les redessine, carrées comme le reste de la charte. */
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.375rem;
    color: var(--text-soft);
  }

  .article-body :global(li) {
    position: relative;
    padding-left: 1.5rem;
    line-height: 1.6;
  }

  .article-body :global(ul > li)::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    /* Centre la puce sur la première ligne : (1.6em − 0.375rem) / 2. */
    top: calc(0.8em - 0.1875rem);
    width: 0.375rem;
    height: 0.375rem;
    background: var(--orange);
  }

  .article-body :global(ol) {
    counter-reset: article-ol;
  }

  .article-body :global(ol > li) {
    counter-increment: article-ol;
    padding-left: 2rem;
  }

  .article-body :global(ol > li)::before {
    content: counter(article-ol) ".";
    position: absolute;
    left: 0;
    min-width: 1.5rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--orange);
  }

  /* Une liste qui suit une introduction (« … : ») s'y rattache visuellement. */
  .article-body :global(p + ul),
  .article-body :global(p + ol) {
    margin-top: -0.5rem;
  }

  .article-body :global(li > ul),
  .article-body :global(li > ol) {
    margin: 0.375rem 0 0;
  }

  .article-body :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--orange-50);
    text-underline-offset: 0.2em;
    transition: color 0.2s var(--ease);
  }

  .article-body :global(a:hover) {
    color: var(--orange);
  }

  .article-body :global(strong) {
    font-weight: 600;
    color: var(--text);
  }

  .article-body :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    border-left: 2px solid var(--orange-25);
    color: var(--text-soft);
    font-style: italic;
  }
</style>
