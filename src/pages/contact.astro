---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientConfig from '../components/ClientConfig.astro';
import RawScript from '../components/RawScript.astro';
import leadApiScript from '../scripts/lead-api.js?raw';
import contactScript from '../scripts/contact.js?raw';

const raisons = [
  {
    titre: 'Une question sur votre estimation',
    texte:
      "Vous avez reçu votre rapport et souhaitez comprendre un chiffre, ou faire préciser un point ? Nous reprenons le dossier avec vous.",
  },
  {
    titre: 'Un bien atypique',
    texte:
      "Loft, bien classé, viager, local mixte : certains biens sortent des grilles. Décrivez-nous la situation, nous adaptons la méthode.",
  },
  {
    titre: 'Devenir partenaire',
    texte:
      "Agence, banque, notaire ou diagnostiqueur : présentez-nous votre activité et votre zone de couverture.",
  },
];
---

<BaseLayout
  title="Contact. Estimer mon bien"
  description="Contactez l'équipe Estimer mon bien pour toute question sur l'estimation de votre bien immobilier. Réponse dans les meilleurs délais."
>
  <Fragment slot="head">
    <ClientConfig />
    <script
      is:inline
      type="text/javascript"
      src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
  </Fragment>

  <section class="contact">
    <div class="container">
      <div class="contact__grid">
        <aside class="contact__aside">
          <span class="eyebrow">Contact</span>
          <h1>Une question ? Nous vous répondons rapidement.</h1>
          <p class="lead">
            Une vraie personne lit chaque message. Décrivez votre situation le plus précisément
            possible : c'est ce qui nous permet de vous répondre utilement du premier coup.
          </p>

          <div class="reasons">
            {
              raisons.map((raison) => (
                <article class="reason">
                  <h3>{raison.titre}</h3>
                  <p>{raison.texte}</p>
                </article>
              ))
            }
          </div>

          <div class="aside-note">
            <strong>Vous cherchez d'abord un chiffre ?</strong>
            <p>
              L'estimation en ligne est gratuite et prend trois minutes. Vous recevez le rapport
              immédiatement.
            </p>
            <a href="/estimation/" class="link-arrow">Estimer mon bien</a>
          </div>
        </aside>

        <div class="form-card">
          <div class="form-card__head">
            <h2>Envoyez-nous un message</h2>
            <p>Tous les champs marqués d'un <span class="required">*</span> sont obligatoires.</p>
          </div>

          <form id="contactForm">
            <div class="field">
              <label for="name">Nom et prénom <span class="required">*</span></label>
              <input type="text" id="name" class="input" placeholder="Jean Dupont" required />
            </div>

            <div class="field">
              <label for="email">Email <span class="required">*</span></label>
              <input
                type="email"
                id="email"
                class="input"
                placeholder="jean.dupont@example.com"
                required
              />
            </div>

            <div class="field">
              <label for="phone">Téléphone</label>
              <input type="tel" id="phone" class="input" placeholder="06 12 34 56 78" />
            </div>

            <div class="field">
              <label for="subject">Sujet <span class="required">*</span></label>
              <select id="subject" class="select" required>
                <option value="">Sélectionnez un sujet</option>
                <option value="estimation">Demande d'estimation</option>
                <option value="partenariat">Devenir partenaire</option>
                <option value="information">Demande d'information</option>
                <option value="autre">Autre</option>
              </select>
            </div>

            <div class="field">
              <label for="message">Message <span class="required">*</span></label>
              <textarea id="message" class="textarea" placeholder="Votre message..." required
              ></textarea>
            </div>

            <button type="submit" class="btn btn--primary btn--lg btn--block">
              Envoyer le message
            </button>
          </form>

          <p class="form-card__foot">
            Vos coordonnées servent à vous répondre. Elles ne sont transmises à un partenaire
            qu'avec votre accord.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- `lead-api.js` avant `contact.js` : ce dernier consomme
       `buildContactLeadPayload`, `requestLead` et `shouldUseLegacyFallback`
       (globales). -->
  <RawScript slot="body-end" code={leadApiScript} />
  <RawScript slot="body-end" code={contactScript} />
</BaseLayout>

<style>
  .contact {
    padding: clamp(2.5rem, 1.5rem + 4vw, 5rem) 0 clamp(3.5rem, 2rem + 5vw, 6rem);
    background:
      radial-gradient(55rem 30rem at 85% -10%, var(--orange-10) 0%, transparent 60%),
      linear-gradient(180deg, var(--beige-25) 0%, var(--beige-10) 100%);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: start;
  }

  .contact__aside {
    position: sticky;
    top: 6rem;
  }

  .contact__aside h1 {
    margin-bottom: 1rem;
  }

  .contact__aside .lead {
    max-width: 32rem;
  }

  .reasons {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .reason {
    padding-left: 1.25rem;
    border-left: 2px solid var(--orange-25);
  }

  .reason h3 {
    font-size: var(--text-md);
    margin-bottom: 0.375rem;
  }

  .reason p {
    font-size: var(--text-sm);
    color: var(--text-soft);
    line-height: 1.55;
  }

  .aside-note {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: var(--white);
  }

  .aside-note strong {
    display: block;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }

  .aside-note p {
    font-size: var(--text-sm);
    color: var(--text-soft);
    line-height: 1.55;
    margin-bottom: 1rem;
  }

  .form-card {
    background: var(--white);
    border: 1px solid var(--border);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .form-card__head {
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .form-card__head h2 {
    font-size: var(--h3);
    margin-bottom: 0.375rem;
  }

  .form-card__head p {
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .required {
    color: var(--orange);
  }

  .form-card button[type='submit'] {
    margin-top: 0.5rem;
  }

  .form-card__foot {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-tiny);
    color: var(--text-faint);
    text-align: center;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact__aside {
      position: static;
    }
  }
</style>
