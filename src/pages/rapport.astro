---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientConfig from '../components/ClientConfig.astro';
import RawScript from '../components/RawScript.astro';
import rapportMapScript from '../scripts/rapport-map.js?raw';
import rapportReportScript from '../scripts/rapport-report.js?raw';

const statsMarche = [
  { value: '+3,2 %', label: 'Évolution annuelle moyenne' },
  { value: '3 000 €', label: 'Prix moyen national au m²' },
  { value: '85 jours', label: 'Délai de vente moyen' },
];
---

<BaseLayout title="Votre rapport d'estimation — Estimer mon bien">
  <Fragment slot="head">
    <ClientConfig />
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Rapport d'estimation</span>
      <h1>Votre rapport d'estimation</h1>
      <p class="lead">Analyse détaillée de votre bien et de son marché local.</p>
    </div>
  </section>

  <section class="rapport">
    <div class="container container--narrow">
      <div class="rapport-container">
        <!-- En-tête visible uniquement dans le PDF -->
        <div class="pdf-header">
          <h1>Estimer mon bien — Rapport d'estimation</h1>
          <p>Analyse détaillée de votre bien immobilier</p>
        </div>

        <!-- Estimation -->
        <div class="report-card estimation-card">
          <h2>Détails de votre bien</h2>
          <div class="property-details" id="propertyDetails">
            <!-- Rempli dynamiquement -->
          </div>

          <div class="price-box">
            <div class="price-label">Estimation moyenne</div>
            <div class="price-value" id="estimationMoyenne">-</div>
            <div class="price-range">
              <div class="price-range-item">
                <div class="price-range-label">Minimum</div>
                <div class="price-range-value" id="estimationMin">-</div>
              </div>
              <div class="price-range-item">
                <div class="price-range-label">Maximum</div>
                <div class="price-range-value" id="estimationMax">-</div>
              </div>
            </div>
          </div>

          <div class="info-box">
            <p><strong>Prix au m² estimé :</strong> <span id="prixM2">-</span></p>
          </div>
        </div>

        <!-- Marché local -->
        <div class="report-card market-card" id="cityAnalysis">
          <h3>Analyse du marché local</h3>
          <!-- Rempli dynamiquement -->
        </div>

        <!-- Localisation -->
        <div class="report-card map-card">
          <h3>Localisation du bien</h3>
          <div id="propertyMap"></div>
          <div class="map-address">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
              ></path>
            </svg>
            <p id="mapFullAddress">Chargement de l'adresse...</p>
          </div>
        </div>

        <!-- Contexte national -->
        <div class="report-card market-card">
          <h3>Le marché immobilier français en 2025</h3>
          <p>
            Le marché immobilier français connaît une dynamique contrastée selon les régions. Les
            grandes métropoles comme Paris, Lyon et Bordeaux maintiennent des prix élevés avec une
            demande soutenue, tandis que les villes moyennes offrent des opportunités plus
            accessibles.
          </p>

          <div class="stats-grid">
            {
              statsMarche.map((stat) => (
                <div class="stat-item">
                  <div class="stat-value">{stat.value}</div>
                  <div class="stat-label">{stat.label}</div>
                </div>
              ))
            }
          </div>

          <p>
            Le Diagnostic de Performance Énergétique (DPE) joue désormais un rôle crucial dans
            l'estimation. Les biens classés A ou B bénéficient d'une surcote pouvant atteindre 15 %,
            tandis que les passoires thermiques (F et G) subissent une décote significative de 15 à
            25 %.
          </p>

          <div class="info-box info-box--tip">
            <p>
              <strong>Bon à savoir :</strong> les biens avec un bon DPE se vendent en moyenne 30 % plus
              rapidement que les biens énergivores. Investir dans la rénovation énergétique peut donc
              être très rentable.
            </p>
          </div>

          <p>
            Cette estimation est calculée à partir des données du marché actuel et prend en compte de
            nombreux critères : localisation, surface, type de bien, nombre de pièces et performance
            énergétique. Pour une évaluation encore plus précise, nos experts peuvent réaliser une
            visite sur place et affiner cette estimation.
          </p>
        </div>

        <!-- Actions -->
        <div class="report-actions">
          <button id="downloadPdfBtn" onclick="downloadPDF()" class="btn btn--primary btn--lg">
            Télécharger le rapport PDF
          </button>
          <a href="/contact" class="btn btn--dark btn--lg">Contacter un expert</a>
          <a href="/estimation" class="btn btn--outline btn--lg">Nouvelle estimation</a>
        </div>

        <!-- Pied de page visible uniquement dans le PDF -->
        <div class="pdf-footer">
          <p>&copy; 2025 Estimer mon bien. Tous droits réservés.</p>
          <p>Estimation générée le <span id="pdfDate"></span></p>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="body-end">
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <RawScript code={rapportMapScript} />
    <RawScript code={rapportReportScript} />
  </Fragment>
</BaseLayout>

<!--
  Le contenu du rapport est injecté par les scripts (détails du bien, analyse
  de marché) : ces styles doivent rester globaux.
-->
<style is:global>
  .rapport {
    padding: clamp(2.5rem, 1.5rem + 3vw, 4rem) 0 clamp(3.5rem, 2rem + 4vw, 5.5rem);
    background: var(--beige-25);
  }

  .report-card {
    background: var(--white);
    border: 1px solid var(--border);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    margin-bottom: 1.5rem;
  }

  .report-card h2 {
    font-size: var(--h3);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .report-card h3 {
    font-size: var(--h4);
    margin-bottom: 1rem;
  }

  .report-card h4 {
    font-size: var(--text-md);
  }

  .report-card p {
    color: var(--text-soft);
    line-height: 1.7;
    margin-bottom: 0.875rem;
  }

  .report-card p:last-child {
    margin-bottom: 0;
  }

  /* Détails du bien (injectés) */
  .property-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.125rem;
    background: var(--white);
  }

  .detail-item .detail-label {
    font-size: var(--text-tiny);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .detail-item .detail-value {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--black);
  }

  /* Bloc de prix */
  .price-box {
    margin: 1.75rem 0;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    background: var(--black);
    color: var(--white);
    text-align: center;
  }

  .price-label {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .price-value {
    font-size: clamp(2.5rem, 1.6rem + 3.2vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0.5rem 0 0;
    color: var(--orange-75);
  }

  .price-range {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .price-range-label {
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
  }

  .price-range-value {
    margin-top: 0.25rem;
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* Grille de chiffres (statique et injectée) */
  .rapport .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    overflow: hidden;
    margin: 1.75rem 0;
  }

  .rapport .stat-item {
    padding: 1.25rem 1rem;
    background: var(--beige-10);
    text-align: center;
  }

  .rapport .stat-value {
    font-size: var(--h4);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--black);
  }

  .rapport .stat-label {
    margin-top: 0.25rem;
    font-size: var(--text-tiny);
    color: var(--text-soft);
  }

  /* Encadré d'information */
  .info-box {
    margin: 1.5rem 0;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--aubergine-4);
    background: var(--beige-25);
  }

  .info-box p {
    margin: 0 0 0.5rem;
    font-size: var(--text-sm);
    color: var(--text);
  }

  .info-box p:last-child {
    margin-bottom: 0;
  }

  .info-box--tip {
    border-left-color: var(--orange);
    border-color: var(--orange-25);
    background: var(--orange-5);
  }

  /* Carte */
  #propertyMap {
    width: 100%;
    height: 22rem;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .map-address {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--border);
    background: var(--beige-25);
  }

  .map-address svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: var(--orange);
    flex-shrink: 0;
  }

  .map-address p {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--black);
  }

  /* Actions */
  .report-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  /* Éléments réservés au PDF */
  .pdf-header,
  .pdf-footer {
    display: none;
  }

  .pdf-header {
    padding: 2rem 0;
    margin-bottom: 2rem;
    background: var(--black);
    color: var(--white);
    text-align: center;
  }

  .pdf-header h1 {
    font-size: 1.75rem;
    color: var(--white);
    margin-bottom: 0.5rem;
  }

  .pdf-footer {
    padding-top: 1.5rem;
    margin-top: 2rem;
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  @media print {
    .announce,
    .site-header,
    .site-footer,
    .page-head,
    .report-actions {
      display: none !important;
    }

    body,
    .rapport {
      background: var(--white);
    }

    .rapport {
      padding: 1rem 0;
    }

    .report-card {
      break-inside: avoid;
    }
  }

  @media (max-width: 640px) {
    .property-details,
    .rapport .stats-grid,
    .price-range {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<style>
  .page-head {
    padding: clamp(2.5rem, 2rem + 3vw, 3.5rem) 0;
    background:
      radial-gradient(50rem 26rem at 75% -20%, var(--orange-10) 0%, transparent 60%),
      linear-gradient(180deg, var(--beige-10) 0%, var(--beige-25) 100%);
    border-bottom: 1px solid var(--border);
  }

  .page-head h1 {
    margin-bottom: 0.75rem;
  }
</style>
