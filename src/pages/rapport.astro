---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientConfig from '../components/ClientConfig.astro';
import RawScript from '../components/RawScript.astro';
import rapportMapScript from '../scripts/rapport-map.js?raw';
import rapportReportScript from '../scripts/rapport-report.js?raw';

const statsMarche = [
  { value: '+3.2%', label: 'Évolution annuelle moyenne' },
  { value: '3 000 €', label: 'Prix moyen national/m²' },
  { value: '85 jours', label: 'Délai de vente moyen' },
];
---

<BaseLayout title="Rapport d'estimation - Estimer mon bien">
  <Fragment slot="head">
    <ClientConfig />
    <meta name="robots" content="noindex" />
  </Fragment>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <h1>Votre rapport d'estimation</h1>
      <p>Analyse détaillée de votre bien immobilier</p>
    </div>
  </section>

  <!-- Rapport Section -->
  <section class="rapport-section">
    <div class="container">
      <div class="rapport-container">
        <!-- PDF Header (visible uniquement dans le PDF) -->
        <div class="pdf-header">
          <h1>Estimer mon bien - Rapport d'estimation</h1>
          <p>Analyse détaillée de votre bien immobilier</p>
        </div>

        <!-- Estimation Card -->
        <div class="estimation-card">
          <h2>Détails de votre bien</h2>
          <div class="property-details" id="propertyDetails">
            <!-- Rempli dynamiquement -->
          </div>

          <div class="price-box">
            <div class="price-label">Estimation moyenne</div>
            <div class="price-value" id="estimationMoyenne">-</div>
            <div class="price-range">
              <div class="price-range-item">
                <div class="price-range-label">Minimum</div>
                <div class="price-range-value" id="estimationMin">-</div>
              </div>
              <div class="price-range-item">
                <div class="price-range-label">Maximum</div>
                <div class="price-range-value" id="estimationMax">-</div>
              </div>
            </div>
          </div>

          <div class="info-box">
            <p><strong>Prix au m² estimé :</strong> <span id="prixM2">-</span></p>
          </div>
        </div>

        <!-- Market Analysis -->
        <div class="market-card" id="cityAnalysis">
          <h3>Analyse du marché local</h3>
          <!-- Rempli dynamiquement -->
        </div>

        <!-- Location Map -->
        <div class="map-card">
          <h3>Localisation du bien</h3>
          <div id="propertyMap"></div>
          <div class="map-address">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
              <path
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
              ></path>
            </svg>
            <p id="mapFullAddress">Chargement de l'adresse...</p>
          </div>
        </div>

        <div class="market-card">
          <h3>Le marché immobilier français en 2025</h3>
          <p>
            Le marché immobilier français connaît une dynamique contrastée selon les régions. Les
            grandes métropoles comme Paris, Lyon et Bordeaux maintiennent des prix élevés avec une
            demande soutenue, tandis que les villes moyennes offrent des opportunités plus
            accessibles.
          </p>

          <div class="stats-grid">
            {
              statsMarche.map((stat) => (
                <div class="stat-item">
                  <div class="stat-value">{stat.value}</div>
                  <div class="stat-label">{stat.label}</div>
                </div>
              ))
            }
          </div>

          <p>
            Le Diagnostic de Performance Énergétique (DPE) joue désormais un rôle crucial dans
            l'estimation. Les biens classés A ou B bénéficient d'une surcote pouvant atteindre 15%,
            tandis que les passoires thermiques (F et G) subissent une décote significative de 15 à
            25%.
          </p>

          <div class="info-box">
            <p>
              <strong>Bon à savoir :</strong> Les biens avec un bon DPE se vendent en moyenne 30% plus
              rapidement que les biens énergivores. Investir dans la rénovation énergétique peut donc
              être très rentable.
            </p>
          </div>

          <p>
            Cette estimation est calculée à partir des données du marché actuel et prend en compte de
            nombreux critères : localisation, surface, type de bien, nombre de pièces, et performance
            énergétique. Pour une évaluation encore plus précise, nos experts peuvent réaliser une
            visite sur place et affiner cette estimation.
          </p>
        </div>

        <!-- CTA -->
        <div class="cta-button-group">
          <button onclick="downloadPDF()" class="cta-button">📥 Télécharger le rapport PDF</button>
          <a href="/contact" class="cta-button">Contacter un expert</a>
          <a href="/estimation" class="cta-button secondary">Nouvelle estimation</a>
        </div>

        <!-- PDF Footer (visible uniquement dans le PDF) -->
        <div class="pdf-footer">
          <p>&copy; 2025 Estimer mon bien. Tous droits réservés.</p>
          <p>Estimation générée le <span id="pdfDate"></span></p>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="body-end">
    <!-- Bibliothèques pour PDF -->
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <RawScript code={rapportMapScript} />
    <RawScript code={rapportReportScript} />
  </Fragment>
</BaseLayout>

<style is:global>
  /* Hero Section */
  .hero {
    background:
      linear-gradient(135deg, rgba(37, 99, 235, 0.45) 0%, rgba(30, 64, 175, 0.45) 100%),
      url("https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=1600&h=400&fit=crop")
        center/cover;
    color: white;
    padding: 60px 0;
    text-align: center;
  }

  .hero h1 {
    font-size: 42px;
    font-weight: 700;
    margin-bottom: 15px;
  }

  .hero p {
    font-size: 18px;
    opacity: 0.95;
  }

  /* Rapport Section */
  .rapport-section {
    padding: 60px 0;
    background-color: #f8f9fa;
  }

  .rapport-container {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Estimation Card */
  .estimation-card {
    background: white;
    border-radius: 12px;
    padding: 40px;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  }

  .estimation-card h2 {
    font-size: 28px;
    margin-bottom: 25px;
    color: #2c3e50;
    border-bottom: 3px solid #2563eb;
    padding-bottom: 15px;
  }

  .property-details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 30px;
  }

  .detail-item {
    display: flex;
    flex-direction: column;
  }

  .detail-label {
    font-size: 14px;
    color: #6c757d;
    margin-bottom: 5px;
    font-weight: 500;
  }

  .detail-value {
    font-size: 18px;
    color: #2c3e50;
    font-weight: 600;
  }

  /* Price Box */
  .price-box {
    background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
    color: white;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    margin: 30px 0;
  }

  .price-label {
    font-size: 16px;
    opacity: 0.9;
    margin-bottom: 10px;
  }

  .price-value {
    font-size: 48px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .price-range {
    display: flex;
    justify-content: space-around;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
  }

  .price-range-item {
    text-align: center;
  }

  .price-range-label {
    font-size: 14px;
    opacity: 0.8;
    margin-bottom: 5px;
  }

  .price-range-value {
    font-size: 24px;
    font-weight: 600;
  }

  /* Market Analysis */
  .market-card {
    background: white;
    border-radius: 12px;
    padding: 40px;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  }

  .market-card h3 {
    font-size: 24px;
    margin-bottom: 20px;
    color: #2c3e50;
  }

  .market-card p {
    color: #6c757d;
    line-height: 1.8;
    margin-bottom: 15px;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 25px 0;
  }

  .stat-item {
    background: #f8f9fa;
    padding: 20px;
    border-radius: 8px;
    text-align: center;
  }

  .stat-value {
    font-size: 32px;
    font-weight: 700;
    color: #2563eb;
    margin-bottom: 8px;
  }

  .stat-label {
    font-size: 14px;
    color: #6c757d;
  }

  /* Info Box */
  .info-box {
    background: #e8f4fd;
    border-left: 4px solid #2563eb;
    padding: 20px;
    margin: 25px 0;
    border-radius: 4px;
  }

  .info-box p {
    margin: 0;
    color: #2c3e50;
  }

  /* CTA Button */
  .cta-button {
    display: inline-block;
    padding: 15px 40px;
    background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
    color: white;
    text-decoration: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 18px;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
    margin-top: 20px;
    border: none;
    cursor: pointer;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(37, 99, 235, 0.3);
  }

  .cta-button.secondary {
    background: white;
    color: #2563eb;
    border: 2px solid #2563eb;
  }

  .cta-button-group {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 40px;
  }

  /* Print styles for PDF */
  @media print {
    header,
    footer,
    .cta-button-group {
      display: none !important;
    }
    body {
      background-color: white;
    }
    .rapport-section {
      padding: 20px 0;
    }
  }

  /* PDF specific styles */
  .pdf-header {
    display: none;
    text-align: center;
    padding: 30px 0;
    background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);
    color: white;
    margin-bottom: 30px;
  }

  .pdf-header h1 {
    font-size: 32px;
    margin-bottom: 10px;
  }

  .pdf-header p {
    font-size: 16px;
    opacity: 0.95;
  }

  .pdf-footer {
    display: none;
    text-align: center;
    padding: 20px 0;
    margin-top: 30px;
    border-top: 2px solid #e0e0e0;
    color: #6c757d;
    font-size: 14px;
  }

  /* Map Card */
  .map-card {
    background: white;
    border-radius: 12px;
    padding: 40px;
    margin-bottom: 30px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
  }

  .map-card h3 {
    font-size: 24px;
    margin-bottom: 20px;
    color: #2c3e50;
  }

  #propertyMap {
    width: 100%;
    height: 400px;
    border-radius: 8px;
    border: 2px solid #e0e0e0;
  }

  .map-address {
    margin-top: 15px;
    padding: 15px;
    background: #f8f9fa;
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .map-address svg {
    width: 24px;
    height: 24px;
    fill: #2563eb;
    flex-shrink: 0;
  }

  .map-address p {
    margin: 0;
    color: #2c3e50;
    font-weight: 500;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero h1 {
      font-size: 32px;
    }

    .property-details {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      grid-template-columns: 1fr;
    }

    .price-range {
      flex-direction: column;
      gap: 15px;
    }

    .estimation-card,
    .market-card {
      padding: 25px;
    }
  }
</style>
