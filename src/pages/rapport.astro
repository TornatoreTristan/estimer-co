---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientConfig from '../components/ClientConfig.astro';
import RawScript from '../components/RawScript.astro';
import rapportMapScript from '../scripts/rapport-map.js?raw';
import pdfReportScript from '../scripts/pdf-report.js?raw';
import estimationApiScript from '../scripts/estimation-api.js?raw';
import rapportReportScript from '../scripts/rapport-report.js?raw';
---

<BaseLayout title="Votre rapport d'estimation. Estimer mon bien">
  <Fragment slot="head">
    <ClientConfig />
    <meta name="robots" content="noindex" />
  </Fragment>

  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Rapport d'estimation</span>
      <h1>Votre rapport d'estimation</h1>
      <p class="lead">Analyse détaillée de votre bien et de son marché local.</p>
    </div>
  </section>

  <section class="rapport">
    <div class="container container--narrow">
      <div class="rapport-container">
        <!-- En-tête visible uniquement dans le PDF -->
        <div class="pdf-header">
          <h1>Estimer mon bien. Rapport d'estimation</h1>
          <p>Analyse détaillée de votre bien immobilier</p>
        </div>

        <!-- Bandeau d'état (mode dégradé, Livre foncier, données
             insuffisantes). Rempli et révélé par `rapport-report.js` :
             son contenu dépend de `lastEstimation.estimationStatus` et de
             `estimation.dataSource`, jamais d'un texte figé ici. -->
        <div class="report-banner" id="estimationStatusBanner" role="status" hidden></div>

        <!-- Estimation -->
        <div class="report-card estimation-card">
          <h2>Détails de votre bien</h2>
          <div class="property-details" id="propertyDetails">
            <!-- Rempli dynamiquement -->
          </div>

          <div class="price-box" id="priceBox">
            <div class="price-label">Estimation moyenne</div>
            <div class="price-value" id="estimationMoyenne">-</div>
            <div class="price-range">
              <div class="price-range-item">
                <div class="price-range-label">Minimum</div>
                <div class="price-range-value" id="estimationMin">-</div>
              </div>
              <div class="price-range-item">
                <div class="price-range-label">Maximum</div>
                <div class="price-range-value" id="estimationMax">-</div>
              </div>
            </div>
            <!-- Amplitude réelle de la fourchette (halfWidthPct), jamais un
                 ±10 % écrit en dur. -->
            <p class="price-range-note" id="rangeNote" hidden></p>
          </div>

          <div class="info-box">
            <p><strong>Prix au m² estimé :</strong> <span id="prixM2">-</span></p>
          </div>

          <!-- Avertissements prêts à afficher fournis par l'API
               (`display.warnings`) — jamais reformulés côté front. -->
          <div id="estimationWarnings" hidden></div>

          <!-- Attribution + avertissement légal : lus dans la réponse de
               l'API (`dataSource.attributionFr` / `disclaimerFr`) pour que la
               date de publication ne se périme pas silencieusement (§8.1). -->
          <div class="source-banner" id="dataSourceBanner" hidden></div>
        </div>

        <!-- Indice de confiance -->
        <div class="report-card" id="confidenceCard" hidden>
          <h3>Fiabilité de l'estimation</h3>
          <div id="confidenceContent"></div>
        </div>

        <!-- Transactions comparables -->
        <div class="report-card" id="comparablesCard" hidden>
          <h3 id="comparablesTitle">Transactions comparables</h3>
          <div id="comparablesContent"></div>
        </div>

        <!-- Méthodologie -->
        <div class="report-card" id="methodologyCard" hidden>
          <h3>Méthodologie</h3>
          <div id="methodologyContent"></div>
        </div>

        <!-- Marché local -->
        <div class="report-card market-card" id="cityAnalysis" hidden>
          <h3>Analyse du marché local</h3>
          <!-- Rempli dynamiquement -->
        </div>

        <!-- Localisation -->
        <div class="report-card map-card">
          <h3>Localisation du bien</h3>
          <div id="propertyMap"></div>
          <div class="map-address">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
              ></path>
            </svg>
            <p id="mapFullAddress">Chargement de l'adresse...</p>
          </div>
        </div>

        <!-- Contexte national.
             Les trois chiffres qui figuraient ici (« +3,2 % », « 3 000 €/m² »,
             « 85 jours ») ainsi que les pourcentages de surcote/décote DPE
             étaient inventés : aucune source ne les portait, et ils
             contredisaient les chiffres réels du bloc d'estimation. Ils sont
             supprimés (§7.2 point 5 et §8.4 : un indicateur non sourçable est
             retiré, pas remplacé par un autre chiffre inventé). L'effet réel
             du DPE sur CETTE estimation est affiché dans la méthodologie
             ci-dessus, avec le coefficient effectivement appliqué. -->
        <div class="report-card market-card">
          <h3>Comprendre votre estimation</h3>
          <p>
            Le marché immobilier français est contrasté selon les régions. Les grandes métropoles
            maintiennent des prix élevés portés par une demande soutenue, tandis que les villes
            moyennes et les zones rurales offrent des niveaux de prix plus accessibles. C'est
            pourquoi cette estimation ne part pas d'une moyenne nationale, mais des ventes
            réellement enregistrées autour de votre bien.
          </p>

          <p>
            Le diagnostic de performance énergétique pèse sur la valeur : un logement bien classé se
            négocie au-dessus d'un équivalent énergivore, à secteur et surface comparables. Le
            coefficient réellement appliqué à votre bien est détaillé dans la section
            « Méthodologie ».
          </p>

          <p>
            Pour une évaluation engageante, seule une visite sur place permet de tenir compte de
            l'état intérieur, de l'exposition, de la vue, des nuisances et des travaux votés en
            copropriété.
          </p>
        </div>

        <!-- Actions -->
        <div class="report-actions">
          <button id="downloadPdfBtn" onclick="downloadPDF()" class="btn btn--primary btn--lg">
            Télécharger le rapport PDF
          </button>
          <a href="/contact/" class="btn btn--dark btn--lg" data-cta="rapport_expert"
            >Contacter un expert</a
          >
          <a href="/estimation/" class="btn btn--outline btn--lg" data-cta="rapport_nouvelle"
            >Nouvelle estimation</a
          >
        </div>

        <!-- Pied de page visible uniquement dans le PDF -->
        <div class="pdf-footer">
          <p>&copy; 2025 Estimer mon bien. Tous droits réservés.</p>
          <p>Estimation générée le <span id="pdfDate"></span></p>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="body-end">
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <!-- `pdf-report.js` vient en premier : il ne fait que déclarer des
         fonctions, dont les helpers (capitalizeWords, formatPrice) que les
         deux autres scripts utilisent dès leur exécution. -->
    <RawScript code={pdfReportScript} />
    <RawScript code={rapportMapScript} />
    <!-- `estimation-api.js` avant `rapport-report.js` : le bouton « Relancer
         le calcul » du mode dégradé rejoue `requestEstimation`. -->
    <RawScript code={estimationApiScript} />
    <RawScript code={rapportReportScript} />
  </Fragment>
</BaseLayout>

<!--
  Le contenu du rapport est injecté par les scripts (détails du bien, analyse
  de marché) : ces styles doivent rester globaux.
-->
<style is:global>
  .rapport {
    padding: clamp(2.5rem, 1.5rem + 3vw, 4rem) 0 clamp(3.5rem, 2rem + 4vw, 5.5rem);
    background: var(--beige-25);
  }

  .report-card {
    background: var(--white);
    border: 1px solid var(--border);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    margin-bottom: 1.5rem;
  }

  .report-card h2 {
    font-size: var(--h3);
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .report-card h3 {
    font-size: var(--h4);
    margin-bottom: 1rem;
  }

  .report-card h4 {
    font-size: var(--text-md);
  }

  .report-card p {
    color: var(--text-soft);
    line-height: 1.7;
    margin-bottom: 0.875rem;
  }

  .report-card p:last-child {
    margin-bottom: 0;
  }

  /* Détails du bien (injectés) */
  .property-details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.125rem;
    background: var(--white);
  }

  .detail-item .detail-label {
    font-size: var(--text-tiny);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .detail-item .detail-value {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--black);
  }

  /* Bloc de prix */
  .price-box {
    margin: 1.75rem 0;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    background: var(--black);
    color: var(--white);
    text-align: center;
  }

  .price-label {
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .price-value {
    font-size: clamp(2.5rem, 1.6rem + 3.2vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0.5rem 0 0;
    color: var(--orange-75);
  }

  .price-range {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1.75rem;
    padding-top: 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  .price-range-label {
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
  }

  .price-range-value {
    margin-top: 0.25rem;
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .price-range-note {
    margin: 1.25rem 0 0;
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.75);
  }

  .price-range-note[hidden] {
    display: none;
  }

  /* La valeur centrale est atténuée quand la confiance est faible, et
     totalement masquée quand l'API pose `display.showCentralValue = false`
     (§3.8) — c'est l'API qui décide, jamais le front. */
  .price-box[data-central='muted'] .price-value {
    color: rgba(255, 255, 255, 0.62);
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.4rem);
  }

  .price-box[data-central='hidden'] .price-value,
  .price-box[data-central='hidden'] .price-label {
    display: none;
  }

  /* Bandeau d'état : mode dégradé, Livre foncier, données insuffisantes */
  .report-banner {
    margin-bottom: 1.5rem;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--orange);
    background: var(--orange-5);
  }

  .report-banner[hidden] {
    display: none;
  }

  .report-banner__title {
    margin: 0 0 0.4rem;
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--black);
  }

  .report-banner p {
    margin: 0 0 0.5rem;
    font-size: var(--text-sm);
    color: var(--text);
    line-height: 1.6;
  }

  .report-banner p:last-child {
    margin-bottom: 0;
  }

  .report-banner .btn {
    margin-top: 0.75rem;
  }

  .report-banner__sep {
    margin: 1rem 0;
    border: 0;
    border-top: 1px solid var(--orange-25);
  }

  .report-banner__retry {
    margin-top: 0.75rem;
    font-size: var(--text-sm);
  }

  .report-banner__retry[hidden] {
    display: none;
  }

  /* Attribution + avertissement légal (§8.1) */
  .source-banner {
    margin-top: 1.5rem;
    padding: 1rem 1.125rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-tiny);
    color: var(--text-faint);
    line-height: 1.6;
  }

  .source-banner[hidden] {
    display: none;
  }

  .source-banner p {
    margin: 0 0 0.5rem;
    font-size: var(--text-tiny);
    color: var(--text-faint);
  }

  .source-banner p:last-child {
    margin-bottom: 0;
  }

  /* Avertissements API (display.warnings) */
  .warning-list {
    margin: 1.25rem 0 0;
    padding: 0.875rem 1.125rem;
    list-style: none;
    border: 1px solid var(--orange-25);
    background: var(--orange-5);
  }

  .warning-list li {
    font-size: var(--text-sm);
    color: var(--text);
    line-height: 1.6;
  }

  .warning-list li + li {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--orange-25);
  }

  /* Jauge de confiance */
  .confidence-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  .confidence-label {
    font-weight: 600;
    color: var(--black);
  }

  .confidence-score {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .confidence-gauge {
    height: 0.75rem;
    background: var(--beige-50);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  /* Pas d'animation de remplissage : la largeur est posée d'emblée, ce qui
     respecte `prefers-reduced-motion` par construction (§7.2 point 2). */
  .confidence-gauge__fill {
    display: block;
    height: 100%;
    background: var(--orange);
  }

  .confidence-gauge__fill[data-level='high'] {
    background: var(--success);
  }

  .confidence-gauge__fill[data-level='low'],
  .confidence-gauge__fill[data-level='insufficient'] {
    background: var(--error);
  }

  .confidence-scale {
    display: flex;
    justify-content: space-between;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
    color: var(--text-faint);
  }

  /* Détails repliés (breakdown, méthodologie) */
  .report-details {
    margin-top: 1.25rem;
    border-top: 1px solid var(--border);
    padding-top: 0.875rem;
  }

  .report-details > summary {
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--black);
  }

  .report-details > summary:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  .breakdown-list {
    margin: 0.875rem 0 0;
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  .breakdown-list div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.875rem;
    background: var(--white);
    font-size: var(--text-sm);
  }

  .breakdown-list dt {
    color: var(--text-soft);
  }

  .breakdown-list dt small {
    display: block;
    margin-top: 0.2rem;
    font-size: var(--text-tiny);
    color: var(--text-faint);
    line-height: 1.5;
  }

  .breakdown-list dd {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--black);
  }

  /* Tableau des comparables */
  .comparables-table-wrap {
    overflow-x: auto;
  }

  .comparables-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .comparables-table caption {
    text-align: left;
    padding-bottom: 0.75rem;
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  .comparables-table th,
  .comparables-table td {
    padding: 0.65rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  .comparables-table th {
    font-size: var(--text-tiny);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    font-weight: 600;
  }

  .comparables-table td:last-child,
  .comparables-table th:last-child {
    text-align: right;
    font-family: var(--font-mono);
  }

  .empty-state {
    padding: 1.125rem 1.25rem;
    border: 1px dashed var(--border);
    background: var(--beige-25);
    font-size: var(--text-sm);
    color: var(--text-soft);
  }

  /* Grille de chiffres (statique et injectée) */
  .rapport .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    overflow: hidden;
    margin: 1.75rem 0;
  }

  .rapport .stat-item {
    padding: 1.25rem 1rem;
    background: var(--beige-10);
    text-align: center;
  }

  .rapport .stat-value {
    font-size: var(--h4);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--black);
  }

  .rapport .stat-label {
    margin-top: 0.25rem;
    font-size: var(--text-tiny);
    color: var(--text-soft);
  }

  /* Encadré d'information */
  .info-box {
    margin: 1.5rem 0;
    padding: 1.125rem 1.25rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--aubergine-4);
    background: var(--beige-25);
  }

  .info-box p {
    margin: 0 0 0.5rem;
    font-size: var(--text-sm);
    color: var(--text);
  }

  .info-box p:last-child {
    margin-bottom: 0;
  }

  .info-box--tip {
    border-left-color: var(--orange);
    border-color: var(--orange-25);
    background: var(--orange-5);
  }

  /* Carte */
  #propertyMap {
    width: 100%;
    height: 22rem;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .map-address {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 0.875rem 1.125rem;
    border: 1px solid var(--border);
    background: var(--beige-25);
  }

  .map-address svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: var(--orange);
    flex-shrink: 0;
  }

  .map-address p {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--black);
  }

  /* Actions */
  .report-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  /* Éléments réservés au PDF */
  .pdf-header,
  .pdf-footer {
    display: none;
  }

  .pdf-header {
    padding: 2rem 0;
    margin-bottom: 2rem;
    background: var(--black);
    color: var(--white);
    text-align: center;
  }

  .pdf-header h1 {
    font-size: 1.75rem;
    color: var(--white);
    margin-bottom: 0.5rem;
  }

  .pdf-footer {
    padding-top: 1.5rem;
    margin-top: 2rem;
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-faint);
  }

  @media print {
    .announce,
    .site-header,
    .site-footer,
    .page-head,
    .report-actions {
      display: none !important;
    }

    body,
    .rapport {
      background: var(--white);
    }

    .rapport {
      padding: 1rem 0;
    }

    .report-card {
      break-inside: avoid;
    }
  }

  @media (max-width: 640px) {
    .property-details,
    .rapport .stats-grid,
    .price-range {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<style>
  .page-head {
    padding: clamp(2.5rem, 2rem + 3vw, 3.5rem) 0;
    background:
      radial-gradient(50rem 26rem at 75% -20%, var(--orange-10) 0%, transparent 60%),
      linear-gradient(180deg, var(--beige-10) 0%, var(--beige-25) 100%);
    border-bottom: 1px solid var(--border);
  }

  .page-head h1 {
    margin-bottom: 0.75rem;
  }
</style>
