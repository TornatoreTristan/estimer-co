---
import BaseLayout from '../layouts/BaseLayout.astro';
import { regionsData, departementsData } from '../data/prix';

const fmt = (n: number) => n.toLocaleString('fr-FR');

const statsNationales = [
  { value: '3 566 €', label: 'Prix moyen au m² en France', change: '−0,3 % sur 12 mois', positive: false },
  { value: '3 011 €', label: 'Prix moyen des maisons', change: '−0,7 % sur 12 mois', positive: false },
  { value: '4 235 €', label: 'Prix moyen des appartements', change: '+0,2 % sur 12 mois', positive: true },
  { value: '331 155 €', label: "Prix médian d'une maison", change: '+27,5 % sur 11 ans', positive: true },
];

const villesCheres = [
  { name: 'Paris', price: '9 850' },
  { name: 'Nice', price: '5 120' },
  { name: 'Lyon', price: '4 890' },
  { name: 'Bordeaux', price: '4 650' },
  { name: 'Aix-en-Provence', price: '4 580' },
];

const villesAbordables = [
  { name: 'Saint-Étienne', price: '1 180' },
  { name: 'Mulhouse', price: '1 320' },
  { name: 'Limoges', price: '1 420' },
  { name: 'Perpignan', price: '1 680' },
  { name: 'Le Havre', price: '1 850' },
];

const zones = [
  {
    id: 'region',
    eyebrow: 'Par région',
    titre: 'Les prix au m² dans les 13 régions',
    infoId: 'regionInfo',
    searchId: 'regionSearch',
    listId: 'regionList',
    placeholder: 'Rechercher une région...',
    attribut: 'data-region',
    entries: Object.entries(regionsData),
  },
  {
    id: 'departement',
    eyebrow: 'Par département',
    titre: 'Les prix au m² département par département',
    infoId: 'departementInfo',
    searchId: 'departementSearch',
    listId: 'departementList',
    placeholder: 'Rechercher un département...',
    attribut: 'data-dept',
    entries: Object.entries(departementsData),
  },
];
---

<BaseLayout
  title="Prix de l'immobilier au m² en France. Estimer mon bien"
  description="Consultez les prix de l'immobilier au m² par région et par département en France, avec l'évolution sur 12 mois et 5 ans."
>
  <!-- --------------------------------------------------------- En-tête -->
  <section class="page-head">
    <div class="container">
      <span class="eyebrow">Données de marché</span>
      <h1>Prix de l'immobilier en France</h1>
      <p class="lead">
        Le prix au m² région par région et département par département, avec l'évolution sur 12 mois
        et sur 5 ans. Le point de départ de toute estimation sérieuse.
      </p>
    </div>
  </section>

  <!-- ------------------------------------------------- Chiffres France -->
  <section class="section--sm section--white stats-strip">
    <div class="container">
      <div class="stat-band">
        {
          statsNationales.map((stat) => (
            <div class="stat">
              <div class="stat__value">{stat.value}</div>
              <div class="stat__label">{stat.label}</div>
              <div class={`stat__change ${stat.positive ? 'is-up' : 'is-down'}`}>{stat.change}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------ Explorateurs -->
  {
    zones.map((zone, index) => (
      <section class={`section ${index % 2 === 0 ? 'section--beige' : 'section--white'}`}>
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">{zone.eyebrow}</span>
            <h2>{zone.titre}</h2>
          </div>

          <div class="explorer">
            <div class="explorer__info card">
              <div class="zone-info" id={zone.infoId}>
                <div class="zone-name">France</div>
                <div class="zone-price">
                  3 566 € <span>/m²</span>
                </div>
                <div class="zone-details">
                  <div class="detail-row">
                    <span class="detail-label">Prix maisons</span>
                    <span class="detail-value">3 011 €/m²</span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Prix appartements</span>
                    <span class="detail-value">4 235 €/m²</span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Évolution 12 mois</span>
                    <span class="detail-value is-down">−0,3 %</span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Évolution 5 ans</span>
                    <span class="detail-value is-up">+15,2 %</span>
                  </div>
                </div>
              </div>
              <p class="zone-hint">
                Sélectionnez une zone dans la liste pour afficher ses chiffres.
              </p>
            </div>

            <div class="explorer__list card">
              <div class="search">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
                <input type="text" id={zone.searchId} class="input" placeholder={zone.placeholder} />
              </div>
              <div class="zone-list" id={zone.listId}>
                {zone.entries.map(([id, data]) => (
                  <button type="button" class="zone-item" {...{ [zone.attribut]: id }}>
                    <span class="name">{data.name}</span>
                    <span class="price">{fmt(data.price)} €/m²</span>
                  </button>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- ------------------------------------------------------ Classements -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Classements</span>
        <h2>Les villes les plus chères et les plus abordables</h2>
        <p>Prix moyen au m², tous types de biens confondus.</p>
      </div>

      <div class="grid grid--2">
        <div class="card">
          <h3 class="rank-title">Les plus chères</h3>
          {
            villesCheres.map((ville, i) => (
              <div class="city">
                <span class="city__rank mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="city__name">{ville.name}</span>
                <span class="city__price">{ville.price} €/m²</span>
              </div>
            ))
          }
        </div>

        <div class="card">
          <h3 class="rank-title">Les plus abordables</h3>
          {
            villesAbordables.map((ville, i) => (
              <div class="city">
                <span class="city__rank mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="city__name">{ville.name}</span>
                <span class="city__price">{ville.price} €/m²</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- -------------------------------------------------------- CTA final -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-head section-head--center">
        <h2>Un prix moyen ne fait pas une estimation</h2>
        <p>
          Ces chiffres situent votre marché. Pour connaître la valeur de votre bien, il faut y
          ajouter sa surface, son état, son exposition et son DPE.
        </p>
      </div>
      <div class="btn-row btn-row--center">
        <a href="/estimation/" class="btn btn--light btn--lg">Estimer mon bien</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { regionsData, departementsData, type ZonePrix } from '../data/prix';

  /** Réécrit la carte d'information avec les chiffres de la zone choisie. */
  function renderInfo(container: HTMLElement, data: ZonePrix) {
    const trend = (v: number) => (v >= 0 ? 'is-up' : 'is-down');
    const sign = (v: number) => (v >= 0 ? '+' : '−');
    const abs = (v: number) => Math.abs(v).toString().replace('.', ',');

    container.innerHTML = `
      <div class="zone-name">${data.name}</div>
      <div class="zone-price">${data.price.toLocaleString('fr-FR')} € <span>/m²</span></div>
      <div class="zone-details">
        <div class="detail-row">
          <span class="detail-label">Prix maisons</span>
          <span class="detail-value">${data.maisons.toLocaleString('fr-FR')} €/m²</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Prix appartements</span>
          <span class="detail-value">${data.apparts.toLocaleString('fr-FR')} €/m²</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Évolution 12 mois</span>
          <span class="detail-value ${trend(data.evol12)}">${sign(data.evol12)}${abs(data.evol12)} %</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">Évolution 5 ans</span>
          <span class="detail-value ${trend(data.evol5)}">${sign(data.evol5)}${abs(data.evol5)} %</span>
        </div>
      </div>
    `;
  }

  /**
   * Câble une liste : clic sur un élément → mise à jour de la carte d'info,
   * saisie dans le champ → filtrage par nom.
   */
  function wireList(options: {
    listId: string;
    infoId: string;
    searchId: string;
    attribute: 'region' | 'dept';
    data: Record<string, ZonePrix>;
  }) {
    const list = document.getElementById(options.listId);
    const info = document.getElementById(options.infoId);
    const search = document.getElementById(options.searchId);
    if (!list || !info || !search) return;

    const items = Array.from(list.querySelectorAll<HTMLElement>('.zone-item'));

    for (const item of items) {
      item.addEventListener('click', () => {
        const key = item.dataset[options.attribute];
        const zone = key ? options.data[key] : undefined;
        if (!zone) return;

        renderInfo(info, zone);
        for (const other of items) other.classList.toggle('active', other === item);
      });
    }

    search.addEventListener('input', (event) => {
      const term = (event.target as HTMLInputElement).value.toLowerCase();
      for (const item of items) {
        const name = item.querySelector('.name')?.textContent?.toLowerCase() ?? '';
        item.style.display = name.includes(term) ? 'flex' : 'none';
      }
    });
  }

  wireList({
    listId: 'regionList',
    infoId: 'regionInfo',
    searchId: 'regionSearch',
    attribute: 'region',
    data: regionsData,
  });

  wireList({
    listId: 'departementList',
    infoId: 'departementInfo',
    searchId: 'departementSearch',
    attribute: 'dept',
    data: departementsData,
  });
</script>

<!--
  Les cartes d'information sont réécrites par le script ci-dessus : leurs styles
  doivent rester globaux pour s'appliquer au HTML injecté à l'exécution.
-->
<style is:global>
  .zone-info {
    text-align: center;
    padding: 0.5rem 0 1.5rem;
  }

  .zone-info .zone-name {
    font-size: var(--h4);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 0.25rem;
  }

  .zone-info .zone-price {
    font-size: clamp(2rem, 1.4rem + 2vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    color: var(--orange);
  }

  .zone-info .zone-price span {
    font-size: var(--text-base);
    font-weight: 400;
    color: var(--text-faint);
  }

  .zone-details {
    margin-top: 1.75rem;
    text-align: left;
  }

  .zone-details .detail-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .zone-details .detail-label {
    color: var(--text-soft);
  }

  .zone-details .detail-value {
    font-weight: 600;
    color: var(--black);
  }

  .detail-value.is-up {
    color: var(--success);
  }

  .detail-value.is-down {
    color: var(--error);
  }
</style>

<style>
  .page-head {
    padding: clamp(3rem, 2rem + 4vw, 5rem) 0;
    background:
      radial-gradient(55rem 30rem at 20% -20%, var(--orange-10) 0%, transparent 60%),
      linear-gradient(180deg, var(--beige-25) 0%, var(--beige-10) 100%);
    border-bottom: 1px solid var(--border);
  }

  .page-head h1 {
    margin-bottom: 1rem;
  }

  .page-head .lead {
    max-width: 40rem;
  }

  .stats-strip .stat__change {
    margin-top: 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--text-tiny);
  }

  .stats-strip .is-up {
    color: var(--success);
  }

  .stats-strip .is-down {
    color: var(--error);
  }

  /* ----------------------------------------------------- Explorateur */
  .explorer {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .explorer__info {
    position: sticky;
    top: 6rem;
  }

  .zone-hint {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-tiny);
    color: var(--text-faint);
    text-align: center;
  }

  .search {
    position: relative;
    margin-bottom: 1rem;
  }

  .search svg {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.125rem;
    height: 1.125rem;
    stroke: var(--aubergine-3);
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }

  .search .input {
    padding-left: 2.75rem;
  }

  .zone-list {
    max-height: 24rem;
    overflow-y: auto;
    display: grid;
    gap: 0.125rem;
    padding-right: 0.25rem;
  }

  .zone-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.75rem 0.875rem;
    border: 1px solid transparent;
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition:
      background-color 0.15s var(--ease),
      border-color 0.15s var(--ease);
  }

  .zone-item:hover {
    background: var(--beige-25);
  }

  .zone-item.active {
    background: var(--orange-5);
    border-color: var(--orange-25);
  }

  .zone-item .name {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .zone-item .price {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--orange);
    white-space: nowrap;
  }

  /* ----------------------------------------------------- Classements */
  .rank-title {
    padding-bottom: 1rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    font-size: var(--text-md);
  }

  .city {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border);
  }

  .city:last-child {
    border-bottom: none;
  }

  .city__rank {
    font-size: var(--text-tiny);
    color: var(--text-faint);
  }

  .city__name {
    flex: 1;
    font-weight: 500;
  }

  .city__price {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  @media (max-width: 900px) {
    .explorer {
      grid-template-columns: minmax(0, 1fr);
    }

    .explorer__info {
      position: static;
    }
  }
</style>
