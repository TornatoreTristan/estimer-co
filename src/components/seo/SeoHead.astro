---
/**
 * Bloc SEO commun à toutes les pages (specs/blog-seo.md §1 et §3 "SEO
 * transverse") : title, meta description, canonical absolu, Open Graph,
 * Twitter Card, robots et les dates `article:*`.
 *
 * Utilisé uniquement par `BaseLayout.astro` — jamais directement par une
 * page — pour que toutes les pages du site restent alignées sur les mêmes
 * règles SEO plutôt que de les réécrire une à une.
 */

interface Props {
  /** Valeur de la balise <title> — `metaTitle` de l'article/page, ou `title` à défaut. */
  title: string;
  description?: string;
  /**
   * Image Open Graph : chemin absolu depuis la racine du site (ex.
   * `/icon-512.png`) ou URL absolue. Par défaut, la plus grande icône du site
   * déjà présente dans `public/` — aucune image dédiée 1200x630 n'existe
   * encore dans le dépôt (hors périmètre, cf. specs/blog-seo.md §7).
   */
  image?: string;
  /** `article` pour une page d'article de blog, `website` pour le reste (défaut). */
  type?: 'website' | 'article';
  /**
   * Empêche l'indexation (pages utilitaires, aperçus internes…). Supprime
   * aussi le `<link rel="canonical">` : un canonical qui pointe vers une page
   * volontairement non indexée (ex. `/404/`) contredirait le `noindex` — les
   * moteurs le liraient comme « la version à indexer est ici », exactement
   * l'inverse de l'intention (QA specs/blog-seo.md).
   */
  noindex?: boolean;
  /** `article:published_time` / `article:modified_time` — utilisées seulement si `type="article"`. */
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
}

const {
  title,
  description,
  image = '/icon-512.png',
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

// Canonical absolu, toujours terminé par `/` : `Astro.url.pathname` l'est déjà
// grâce à `trailingSlash: 'always'` (astro.config.mjs), donc `canonicalUrl`
// aussi.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const toIso = (value: Date | string | undefined) => {
  if (!value) return undefined;
  return value instanceof Date ? value.toISOString() : new Date(value).toISOString();
};

const publishedTimeIso = type === 'article' ? toIso(publishedTime) : undefined;
const modifiedTimeIso = type === 'article' ? toIso(modifiedTime) : undefined;
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
{!noindex && <link rel="canonical" href={canonicalUrl} />}
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content="Estimer mon bien" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={imageUrl} />
<meta property="og:locale" content="fr_FR" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={imageUrl} />

{publishedTimeIso && <meta property="article:published_time" content={publishedTimeIso} />}
{modifiedTimeIso && <meta property="article:modified_time" content={modifiedTimeIso} />}
