---
/**
 * Sérialise un objet en JSON-LD (`<script type="application/ld+json">`).
 *
 * Le seul rôle de ce composant est d'échapper `<` avant `set:html` : une
 * chaîne de contenu éditorial (titre d'article, réponse de FAQ…) qui
 * contiendrait littéralement `</script>` fermerait sinon la balise
 * prématurément — `<` reste un JSON valide et un objet JSON-LD identique
 * pour tout interpréteur (Google Rich Results, schema.org...).
 */

interface Props {
  data: Record<string, unknown>;
}

const { data } = Astro.props;

const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} is:inline />
