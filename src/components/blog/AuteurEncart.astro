---
/**
 * Encadré « À propos de l'auteur », en fin d'article. L'ancre `#auteur` est
 * la cible du nom cliquable de l'en-tête (ArticleHeader).
 */
import type { Auteur, TypeLien } from '../../lib/auteurs';

interface Props {
  auteur: Auteur;
}

const { auteur } = Astro.props;

// Tracés 24×24 dessinés en `currentColor` : l'icône suit la couleur du lien.
const ICONES: Record<TypeLien, string> = {
  linkedin:
    'M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.26 2.37 4.26 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  x: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z',
  site: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.93 6h-2.95a15.7 15.7 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14a8.2 8.2 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4H4.26zm.81 2h2.95c.32 1.25.78 2.45 1.38 3.56A8 8 0 0 1 5.07 16zm2.95-8H5.07a8 8 0 0 1 4.33-3.56A15.7 15.7 0 0 0 8.02 8zM12 19.96A14.1 14.1 0 0 1 10.09 16h3.82A14.1 14.1 0 0 1 12 19.96zM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56zM16.36 14a16.5 16.5 0 0 0 0-4h3.38a8.2 8.2 0 0 1 0 4h-3.38z',
  email:
    'M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4.24-8 5-8-5V6l8 5 8-5v2.24z',
};
---

<aside class="auteur" id="auteur" aria-labelledby="auteur-nom">
  {
    auteur.photo ? (
      <img
        class="auteur__photo"
        src={auteur.photo}
        alt={`Portrait de ${auteur.nom}`}
        width="72"
        height="72"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="auteur__photo auteur__photo--initiales" aria-hidden="true">
        {auteur.initiales}
      </div>
    )
  }
  <div class="auteur__texte">
    <div class="auteur__surtitre mono">À propos de l'auteur</div>
    <div class="auteur__nom" id="auteur-nom">{auteur.nom}</div>
    <div class="auteur__fonction">{auteur.fonction}</div>
    <div class="auteur__bio">{auteur.bio}</div>
    {
      auteur.liens.length > 0 && (
        <div class="auteur__liens">
          {auteur.liens.map((lien) => {
            const externe = lien.type !== 'email';
            return (
              <a
                class="auteur__lien"
                href={lien.url}
                aria-label={lien.libelle}
                {...(externe && { rel: `noopener noreferrer${lien.type === 'site' ? '' : ' me'}`, target: '_blank' })}
              >
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                  <path d={ICONES[lien.type]} fill="currentColor" />
                </svg>
                <span>{lien.texte}</span>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</aside>

<style>
  .auteur {
    display: flex;
    gap: 1.25rem;
    margin: 2.5rem 0 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: var(--beige-25);
    scroll-margin-top: 6rem;
  }

  .auteur__photo {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
  }

  .auteur__photo--initiales {
    display: grid;
    place-items: center;
    background: var(--aubergine-0);
    color: var(--white);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .auteur__surtitre {
    font-size: var(--text-tiny);
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .auteur__nom {
    margin-top: 0.25rem;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--text);
  }

  .auteur__fonction {
    font-size: var(--text-sm);
    /* Pas l'orange : sous 3:1 sur ce fond, illisible en texte. */
    color: var(--aubergine-3);
    font-weight: 500;
  }

  .auteur__bio {
    margin: 0.75rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--text-soft);
  }

  .auteur__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
  }

  /* Préfixés par `.auteur` : sinon le style des liens du corps d'article
     (`.article-body a`, plus spécifique) soulignerait ces liens. */
  .auteur .auteur__lien {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }

  .auteur .auteur__lien svg {
    flex: none;
    color: var(--aubergine-3);
    transition: color 0.2s var(--ease);
  }

  .auteur .auteur__lien:hover,
  .auteur .auteur__lien:hover svg {
    color: var(--orange);
  }

  .auteur .auteur__lien:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  @media (max-width: 30rem) {
    .auteur {
      flex-direction: column;
      gap: 1rem;
      padding: 1.25rem;
    }
  }
</style>
