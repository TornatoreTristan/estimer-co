---
/**
 * Encadré « À propos de l'auteur », en fin d'article. L'ancre `#auteur` est
 * la cible du nom cliquable de l'en-tête (ArticleHeader).
 */
import type { Auteur } from '../../lib/auteurs';

interface Props {
  auteur: Auteur;
}

const { auteur } = Astro.props;
---

<aside class="auteur" id="auteur" aria-labelledby="auteur-nom">
  {
    auteur.photo ? (
      <img
        class="auteur__photo"
        src={auteur.photo}
        alt={`Portrait de ${auteur.nom}`}
        width="72"
        height="72"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="auteur__photo auteur__photo--initiales" aria-hidden="true">
        {auteur.initiales}
      </div>
    )
  }
  <div class="auteur__texte">
    <div class="auteur__surtitre mono">À propos de l'auteur</div>
    <div class="auteur__nom" id="auteur-nom">{auteur.nom}</div>
    <div class="auteur__fonction">{auteur.fonction}</div>
    <div class="auteur__bio">{auteur.bio}</div>
  </div>
</aside>

<style>
  .auteur {
    display: flex;
    gap: 1.25rem;
    margin: 2.5rem 0 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: var(--beige-25);
    scroll-margin-top: 6rem;
  }

  .auteur__photo {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    object-fit: cover;
  }

  .auteur__photo--initiales {
    display: grid;
    place-items: center;
    background: var(--aubergine-0);
    color: var(--white);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .auteur__surtitre {
    font-size: var(--text-tiny);
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .auteur__nom {
    margin-top: 0.25rem;
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--text);
  }

  .auteur__fonction {
    font-size: var(--text-sm);
    /* Pas l'orange : sous 3:1 sur ce fond, illisible en texte. */
    color: var(--aubergine-3);
    font-weight: 500;
  }

  .auteur__bio {
    margin: 0.75rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--text-soft);
  }

  @media (max-width: 30rem) {
    .auteur {
      flex-direction: column;
      gap: 1rem;
      padding: 1.25rem;
    }
  }
</style>
