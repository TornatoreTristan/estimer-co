---
/**
 * Carte d'un article dans une liste (silo, index du blog). Une seule source
 * de vérité pour l'URL (`getArticleUrl`, `src/lib/blog.ts`) : jamais
 * recomposée à la main ici.
 */
import { getArticleUrl } from '../../lib/blog';
import { AUTEUR_PAR_DEFAUT, getAuteur, type AuteurId } from '../../lib/auteurs';

interface Props {
  title: string;
  extrait?: string;
  image?: string;
  imageAlt?: string;
  /** Point d'intérêt vertical en % (voir `imageCadrage`, src/content.config.ts). */
  imageCadrage?: number;
  categorie: string;
  slug: string;
  datePublication?: Date;
  auteur?: AuteurId;
}

const {
  title,
  extrait,
  image,
  imageAlt,
  imageCadrage = 50,
  categorie,
  slug,
  datePublication,
  auteur: auteurId = AUTEUR_PAR_DEFAUT,
} = Astro.props;

const auteur = getAuteur(auteurId);

const href = getArticleUrl(categorie, slug);

const dateLisible = datePublication
  ? new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(
      datePublication
    )
  : undefined;
const dateIso = datePublication ? datePublication.toISOString().slice(0, 10) : undefined;
---

<article class="card card--hover article-card">
  {
    image && (
      <a href={href} class="article-card__image" tabindex="-1" aria-hidden="true">
        {/*
          Dimensions fixées en dur (16/9) plutôt que dérivées du fichier
          réel : `image` reste un `z.string()` (pas le helper `image()`
          d'astro:assets, cf. src/content.config.ts), sa taille intrinsèque
          n'est donc pas connue au build. Le ratio CSS ci-dessous (voir
          `.article-card__image img`) réserve le même espace quelle que soit
          la vraie taille du fichier — c'est ce qui évite le CLS, pas ces
          attributs en eux-mêmes.
        */}
        <img
          src={image}
          alt={imageAlt ?? ''}
          width="640"
          height="360"
          loading="lazy"
          decoding="async"
          style={`object-position: 50% ${imageCadrage}%`}
        />
      </a>
    )
  }
  <h3>
    <a href={href}>{title}</a>
  </h3>
  {extrait && <p>{extrait}</p>}
  <div class="article-card__meta mono">
    {auteur.photo && <img src={auteur.photo} alt="" width="28" height="28" loading="lazy" decoding="async" />}
    <span>
      <span class="article-card__auteur">{auteur.nom}</span>
      {
        dateLisible && (
          <>
            {' · '}
            <time datetime={dateIso}>{dateLisible}</time>
          </>
        )
      }
    </span>
  </div>
</article>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
  }

  .article-card__image {
    display: block;
    margin: calc(-1 * clamp(1.5rem, 1rem + 1.2vw, 2rem)) calc(-1 * clamp(1.5rem, 1rem + 1.2vw, 2rem))
      1rem;
  }

  .article-card__image img {
    width: 100%;
    /* Sans `height: auto`, l'attribut height="360" l'emporte sur le ratio. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-card h3 {
    font-size: var(--h4);
    margin-bottom: 0.625rem;
  }

  .article-card p {
    flex: 1;
    margin-bottom: 1rem;
  }

  .article-card__meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-tiny);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .article-card__meta img {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    object-fit: cover;
  }

  .article-card__auteur {
    color: var(--text-soft);
  }
</style>
