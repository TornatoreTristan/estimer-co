---
/**
 * Fil d'ariane visible + JSON-LD `BreadcrumbList` (specs/blog-seo.md §3
 * "Données structurées" : les deux doivent rester identiques, ce composant
 * les génère donc depuis la même liste plutôt que de risquer une divergence).
 */
import JsonLd from './seo/JsonLd.astro';

interface BreadcrumbItem {
  label: string;
  /** Chemin interne, toujours terminé par `/` (cf. `trailingSlash: 'always'`). */
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href, Astro.site).toString(),
  })),
};
---

<nav class="breadcrumb" aria-label="Fil d'ariane">
  <ol>
    {
      items.map((item, index) => {
        const isLast = index === items.length - 1;
        return (
          <li>
            {isLast ? (
              <span aria-current="page">{item.label}</span>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<JsonLd data={breadcrumbJsonLd} />

<style>
  .breadcrumb {
    padding: 1.25rem 0;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    font-size: var(--text-sm);
  }

  .breadcrumb li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
  }

  .breadcrumb li:not(:last-child)::after {
    content: '/';
    color: var(--text-faint);
  }

  .breadcrumb li:last-child {
    overflow: hidden;
  }

  .breadcrumb a {
    color: var(--text-soft);
    transition: color 0.2s var(--ease);
  }

  .breadcrumb a:hover {
    color: var(--orange);
  }

  .breadcrumb span[aria-current='page'] {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text);
    font-weight: 500;
  }
</style>
