---
const NAV = [
  { href: '/', label: 'Accueil' },
  { href: '/estimation/', label: 'Estimation' },
  { href: '/carte/', label: "Prix de l'immobilier" },
  { href: '/partenaires/', label: 'Partenaires' },
  { href: '/contact/', label: 'Contact' },
] as const;

// `trailingSlash: 'always'` (astro.config.mjs) : les liens internes s'écrivent
// avec la barre finale, comme `Astro.url.pathname`. On normalise quand même
// les deux côtés de la comparaison plutôt que de dépendre de cette égalité de
// forme — un href écrit sans barre perdrait sinon son état "page courante"
// sans que rien ne le signale.
const stripTrailingSlash = (value: string) =>
  value !== '/' && value.endsWith('/') ? value.slice(0, -1) : value;

const current = stripTrailingSlash(Astro.url.pathname);
---

<div class="announce">
  Estimation gratuite, rapport complet immédiat. <a href="/estimation/">Commencer &rarr;</a>
</div>

<header class="site-header" id="siteHeader">
  <div class="container">
    <div class="site-header__inner">
      <a href="/" class="brand" aria-label="Estimer mon bien, accueil">
        <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="32" height="32" fill="#1d0c1b"></rect>
          <path d="M9 15.5 16 9.5l7 6" stroke="#ff6e34" stroke-width="2.2" stroke-linecap="square"
            stroke-linejoin="miter" fill="none"></path>
          <path
            d="M10.75 15v7.5h10.5V15"
            stroke="#ffffff"
            stroke-width="2.2"
            stroke-linecap="square"
            stroke-linejoin="miter"
            fill="none"></path>
        </svg>
        <span>Estimer mon bien</span>
      </a>

      <nav class="site-nav" id="siteNav" aria-label="Navigation principale">
        {
          NAV.map(({ href, label }) => (
            <a href={href} aria-current={current === stripTrailingSlash(href) ? 'page' : undefined}>
              {label}
            </a>
          ))
        }
        <a href="/estimation/" class="btn btn--primary">Estimer mon bien</a>
      </nav>

      <div class="site-header__actions">
        <a href="/estimation/" class="btn btn--primary">Estimer mon bien</a>
        <button
          type="button"
          class="nav-toggle"
          id="navToggle"
          aria-expanded="false"
          aria-controls="siteNav"
          aria-label="Ouvrir le menu"
        >
          <svg class="icon-open" viewBox="0 0 24 24" aria-hidden="true">
            <line x1="4" y1="8" x2="20" y2="8"></line>
            <line x1="4" y1="16" x2="20" y2="16"></line>
          </svg>
          <svg class="icon-close" viewBox="0 0 24 24" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18"></line>
            <line x1="18" y1="6" x2="6" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('siteHeader');
  const toggle = document.getElementById('navToggle');

  toggle?.addEventListener('click', () => {
    const open = header?.dataset.open === 'true';
    if (header) header.dataset.open = open ? 'false' : 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
  });
</script>
